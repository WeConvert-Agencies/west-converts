1px solid var(--head-line)}\n  #faq .container{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:var(--sp-9);align-items:start}\n  #faq .sec-head{margin:0;text-align:left;max-width:none}\n  #faq .sec-head{position:sticky;top:calc(var(--header-h) + 2rem)}\n  #faq .sec-head h2{max-width:15ch}\n  #faq .faq{width:100%;max-width:none}\n}\n@media (max-width:1040px){\n  .hero__inner{grid-template-columns:1fr}\n  .hero h1{max-width:17ch}\n  .hero__visual{width:100%;max-width:38rem;justify-self:center}\n  .flow{max-width:none}\n  .hero__glow{width:120vw;right:-40%}\n/* ===================== reduced motion ===================== */\n/* Fewer, gentler: drop spatial movement and loops, keep color/opacity feedback. */\n@media (prefers-reduced-motion:reduce){\n  html{scroll-behavior:auto}\n  .js .hero .up,.js .hero h1.up{animation:none;opacity:1;transform:none}\n  .hero__stage{transform:none;transition:none}\n  [data-reveal].reveal-ready{opacity:1;transform:none;transition:none}\n  .nav-ready .nav,.preview-switch button,.flow__fill,.flow__ic,.flow__v,[data-f],.flow__step > div{transition:none}\n  .flow.is-swapping [data-f]{opacity:1;filter:none}\n  .scard--receptionist:hover .voice-visual i{animation:none}\n  .hero__glow,.cta__glow{animation:none}\n  .js .hero .up{transform:none;filter:none;animation-duration:.25s}\n  .mcta{transition:none}\n  .chatw,.chatw__panel{transition:none;animation:none}\n  .sub:hover,.scard:hover,.mcard:hover,.scard:focus-within,.mcard:focus-within,.chatw__btn:hover{transform:none}\n  .io .trust__row:not(.in) > li,.io .trust__row.in > li{animation:none;opacity:1;transform:none}\n  .trust__item:hover{transform:none}\n  .btn:hover,.btn:active,.btn:hover .btn__arrow,.btn:focus-visible .btn__arrow,.svc__more:hover svg{transform:none}\n  .slink:hover svg,.slink:focus-visible svg,.invite:hover svg,.nav a:active,.faq__q:active{transform:none}\n  .svc::before{transform:none}\n  .svc:hover .svc__name svg{transform:none}\n  .bar span,.steps__fill,.faq__a,.faq__ic,.nav__ind{transition:none}\n}\n@media print{.header,.cta__glow,.hero__media,.mcta{display:none}}\n  <div class=\"container hero__inner\">\n    <div class=\"hero__copy\">\n      <p class=\"eyebrow up\" style=\"--d:0ms\">Ads · Websites · Automation</p>\n      <h1 class=\"up\" style=\"--d:70ms\">Helping your trade business get more <span class=\"hl\">booked jobs</span>.</h1>\n      <p class=\"hero__lede up\" style=\"--d:140ms\">Meta and Google ads are what we do best — backed by the websites and AI receptionists that turn every click into a call. Built for HVAC, roofing, plumbing and electrical businesses who want a straight answer, not a sales pitch.</p>\n      <div class=\"hero__ctas up\" style=\"--d:220ms\">\n        <a class=\"btn btn--primary btn--lg\" href=\"#start\">\n          Book Your Free Strategy Call\n          <svg class=\"btn__arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n        </a>\n        <a class=\"btn btn--ghost-dark btn--lg\" href=\"#process\">See how it works</a>\n      </div>\n    </div>\n</section>\n\n<!-- ============================ SERVICES ============================ -->\n<section class=\"section svc-sec\" id=\"services\">\n  <div class=\"container\">\n    <p class=\"eyebrow section-label\">01 / Services</p>\n    <div class=\"sec-head\">\n      <h2>Everything that turns a search into a booked job.</h2>\n      <p>Ads are what we do best. Everything else here exists to make those ads pay off: the page they land on, the phone that gets answered, and the listing people check before they call.</p>\n    </div>\n\n    <!-- Flagship: ads lead, visually and in order -->\n    <article class=\"flag\" data-reveal>\n      <div class=\"flag__main\">\n        <div class=\"flag__top\"><span class=\"sic sic--d\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 15v-4a2 2 0 012-2h2l7-4v16l-7-4H5a2 2 0 01-2-2z\"/><path d=\"M18 9.5a4 4 0 010 5\"/></svg></span><span class=\"tag tag--red\">Flagship service</span></div>\n        <h3>Meta &amp; Google Ads</h3>\n      </div>\n    </div>\n\n    <div class=\"svc-cta\">\n      <p>Not sure where to start?<span>Tell us about your business and we&rsquo;ll recommend what fits on a free strategy call. No pitch deck.</span></p>\n      <a class=\"btn btn--primary btn--lg\" href=\"#start\">Book Your Free Strategy Call <svg class=\"btn__arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n    </div>\n  </div>\n</section>\n\n<!-- ============================ PROCESS ============================ -->\n<section class=\"section\" id=\"process\">\n  <div class=\"container\">\n    <p class=\"eyebrow section-label\">02 / How it works</p>\n    <div class=\"sec-head\">\n      <h2>From first call to live ads, without the runaround.</h2>\n      <p>Four steps from the first call to leads coming in.</p>\n    </div>\n\n    <div class=\"steps\">\n      <span class=\"steps__track\" aria-hidden=\"true\"><span class=\"steps__fill\"></span></span>\n      <ol class=\"steps__list\">\n        <li class=\"step\">\n          <span class=\"step__node\" aria-hidden=\"true\">1</span>\n<script>\n(function(){\n  \"use strict\";\n  var doc = document.documentElement;\n  var motionQuery = window.matchMedia(\"(prefers-reduced-motion: reduce)\");\n  var reduce = motionQuery.matches;\n  var hasIO = \"IntersectionObserver\" in window;\n  var each = function(list, fn){ Array.prototype.forEach.call(list, fn); };\n  var motionUpdates = [];\n  var watchMedia = function(query, fn){\n    if (query.addEventListener) query.addEventListener(\"change\", fn);\n    else if (query.addListener) query.addListener(fn);\n  };\n  if (hasIO) doc.classList.add(\"io\");\n\n  var y = document.getElementById(\"year\");\n  if (y) y.textContent = new Date().getFullYear();\n\n  /* ---------- sticky header ---------- */\n  var header = document.getElementById(\"header\");\n  var onScroll = function(){ header.classList.toggle(\"stuck\", window.scrollY > 8); };\n  onScroll();\n  window.addEventListener(\"scroll\", onScroll, {passive:true});\n\n  /* ---------- mobile nav: collapse only after controls are ready ---------- */\n  var toggle = document.getElementById(\"navtoggle\");\n  var nav = document.getElementById(\"nav\");\n  var setNav = function(open){\n    header.classList.toggle(\"open\", open);\n    toggle.setAttribute(\"aria-expanded\", String(open));\n    toggle.setAttribute(\"aria-label\", open ? \"Close menu\" : \"Open menu\");\n  };\n","exit_code":0,"status":"completed"}}
