===========================================================\n   West Converts — design tokens\n   Palette rule: ~90% neutral, brick red used only as accent moments.\n   =================================================================== */\n:root{\n  /* ===== approved stage-1 system: charcoal + white/stone, brick red accent ===== */\n  --char:#0A0A0A; --char-2:#121212; --card-d:#171717; --card-d2:#1F1F1F; --line-d:#2E2E2E; --ui-d:#737373;\n  --on-d:#FAFAFA; --on-d2:#A3A3A3;\n  --red:#B91C1C; --red-2:#991B1B; --ember:#D85A5A;\n\n  /* light-section neutrals (legacy names kept so not-yet-rebuilt sections inherit the new palette) */\n  --paper:#FFFFFF; --paper-2:#F5F5F4; --paper-3:#EFEFEE;\n  --ink:#0A0A0A; --ink-soft:#262626; --ink-muted:#525252;\n  --line:#E5E5E5; --line-strong:#D4D4D4; --ui-l:#8A8A8A;\n  --inverse:#0A0A0A; --on-inverse:#FAFAFA; --on-inverse-muted:#A3A3A3; --on-inverse-line:#2E2E2E;\n  --inverse-2:#171717; --accent-on-inverse:#D85A5A;\n\n  /* accent is brick red (was purple); ember is the red for small text/icons on dark */\n  --accent:#B91C1C; --accent-2:#991B1B; --accent-bright:#D85A5A; --accent-tint:#FEF2F2; --accent-line:#FECACA;\n  --grad:linear-gradient(90deg,#B91C1C,#B91C1C);\n  --grad-soft:linear-gradient(90deg,#D85A5A,#D85A5A);\n  --focus:#0A0A0A;\n\n  /* type: Archivo, one family */\n  --font-display:'Archivo',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n  --font-body:'Archivo',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n  --font-accent:'Archivo',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\n  --fs-display:clamp(2.5rem,1.25rem + 4vw,5rem);\n  --fs-h2:clamp(2rem,1.3rem + 2.5vw,3.75rem);\n  --fs-h3:clamp(1.25rem,1.1rem + .5vw,1.5rem);\n  --fs-lg:clamp(1.0625rem,.98rem + .45vw,1.1875rem);\n  --fs-body:1.0625rem;\n  --fs-sm:0.9375rem;\n  --fs-xs:0.8125rem;\n\n  /* space */\n  --sp-1:0.25rem; --sp-2:0.5rem;  --sp-3:0.75rem; --sp-4:1rem;\n  --sp-5:1.5rem;  --sp-6:2rem;    --sp-7:2.5rem;  --sp-8:3rem;\n  --sp-9:4rem;    --sp-10:5.5rem;\n  --section-y:clamp(4rem,7.5vw,7rem);\n  --section-y-short:clamp(3.5rem,6vw,5.5rem);\n  --container:1200px;\n  --gutter:clamp(1.125rem,4vw,2rem);\n  --header-h:80px;\n\n  /* form */\n  --r-sm:8px; --r:14px; --r-lg:24px; --r-pill:999px; --r-btn:12px;\n  --shadow-sm:0 1px 2px rgba(10,10,10,.04),0 8px 24px -16px rgba(10,10,10,.16);\n  --shadow-d:inset 0 1px 0 rgba(255,255,255,.04),0 20px 44px -28px rgba(0,0,0,.7);\n  --shadow:0 2px 6px rgba(10,10,10,.05),0 12px 28px -8px rgba(10,10,10,.12);\n  --shadow-lg:0 8px 20px rgba(10,10,10,.08),0 28px 60px -12px rgba(10,10,10,.18);\n  --shadow-accent:0 6px 16px -6px rgba(185,28,28,.5);\n  --feedback:.22s; --lift:-3px; --reveal-y:16px;\n  --ease:cubic-bezier(.16,1,.3,1);\n  --ease-out:cubic-bezier(.33,1,.68,1);\n}\n\n/* ===================== base ===================== */\n*,*::before,*::after{box-sizing:border-box}\nhtml{scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 16px);-webkit-text-size-adjust:100%}\nbody{\n  margin:0;\n  background:var(--paper);\n  color:var(--ink-soft);\n  font-family:var(--font-body);\n  font-size:var(--fs-body);\n  line-height:1.6;\n  -webkit-font-smoothing:antialiased;\n  -moz-osx-font-smoothing:grayscale;\n  overflow-x:hidden;\n}\nh1,h2,h3,h4{\n  font-family:var(--font-display);\n  color:var(--ink);\n  margin:0;\n  line-height:1.08;\n  letter-spacing:-0.022em;\n  font-weight:700;\n  text-wrap:balance;\n}\nh1{font-size:var(--fs-display);letter-spacing:-.035em;line-height:1.04;font-weight:800}\nh2{font-size:var(--fs-h2);letter-spacing:-.032em;font-weight:800}\nh3{font-size:var(--fs-h3);line-height:1.25;letter-spacing:-0.012em}\np{margin:0}\na{color:inherit}\nimg{max-width:100%;display:block}\nul{margin:0;padding:0;list-style:none}\nbutton{font:inherit;color:inherit}\n:focus-visible{outline:2.5px solid var(--focus);outline-offset:3px;border-radius:4px}\n::selection{background:var(--accent);color:#fff}\n\n.container{width:100%;max-width:var(--container);margin-inline:auto;padding-inline:var(--gutter)}\n.section{padding-block:var(--section-y)}\n.section--tint{background:var(--paper-2)}\n.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}\n.skip{\n  position:absolute;left:var(--sp-4);top:-100px;z-index:200;\n  background:var(--ink);color:var(--paper);padding:.7rem 1.1rem;\n  border-radius:var(--r-sm);font-weight:600;font-size:var(--fs-sm);\n  transition:top .2s var(--ease);\n}\n.skip:focus{top:var(--sp-4)}\n#main:focus{outline:none}\n\n/* ===================== browser surfaces ===================== */\nhtml{scrollbar-color:var(--line-strong) var(--paper)}\n::selection{background:var(--accent);color:var(--paper)}\ninput,textarea{caret-color:var(--accent)}\na{text-underline-offset:.22em;text-decoration-thickness:1px}\n\n/* Motion is reserved for moments that explain something: the hero lead path,\n   the process line, the pricing bar, nav position and control feedback.\n   \"io\" is set by the main script, so if JS fails nothing stays hidden. */\n\n/* ===================== header (dark, sticky, persistent CTA) ===================== */\n.header{\n  position:sticky;top:0;z-index:100;\n  background:rgba(10,10,10,.97);\n  backdrop-filter:saturate(140%) blur(12px);-webkit-backdrop-filter:saturate(140%) blur(12px);\n  border-bottom:1px solid transparent;\n  transition:border-color .3s var(--ease),background .3s var(--ease);\n}\n.header.stuck{border-bottom-color:var(--line-d);background:rgba(10,10,10,.92)}\n.header__inner{display:flex;align-items:center;gap:var(--sp-5);height:var(--header-h)}\n.brand{display:inline-flex;align-items:center;gap:.6rem;min-height:44px;text-decoration:none;font-family:var(--font-display);font-weight:800;font-size:1.125rem;letter-spacing:-.02em;color:var(--on-d);white-space:nowrap}\n.brand__mark{width:34px;height:34px;flex:none;border-radius:9px;background:linear-gradient(145deg,#C7342E,var(--red-2));display:grid;place-items:center;box-shadow:inset 0 1px 0 rgba(255,255,255,.18)}\n.brand__mark svg{width:25px;height:25px}\n.nav{position:relative;display:flex;align-items:center;gap:.25rem;margin-left:auto}\n.nav a{\n  text-decoration:none;color:var(--on-d2);font-size:var(--fs-sm);font-weight:500;\n  padding:.6rem .8rem;border-radius:var(--r-sm);position:relative;min-height:44px;display:inline-flex;align-items:center;\n  transition:color var(--feedback) var(--ease),background var(--feedback) var(--ease),transform var(--feedback) var(--ease);\n}\n.nav a:hover,.nav a:focus-visible{color:var(--on-d);background:var(--card-d)}\n.nav a:active{transform:translateY(1px)}\n.nav a[aria-current=\"true\"]{color:var(--on-d)}\n/* one indicator that travels between links instead of per-link underlines */\n.nav__ind{\n  position:absolute;left:0;bottom:.2rem;width:100px;height:2px;border-radius:2px;background:var(--red);\n  transform-origin:0 50%;opacity:0;pointer-events:none;\n  transition:transform .45s var(--ease),opacity .25s var(--ease);\n}\n.header__cta{margin-left:var(--sp-4)}\n.header__cta .btn{min-height:44px;padding:0 1.15rem}\n.navtoggle{\n  display:none;flex:none;background:none;border:1px solid var(--ui-d);color:var(--on-d);\n  border-radius:var(--r-sm);width:44px;height:44px;align-items:center;justify-content:center;cursor:pointer;\n}\n.navtoggle svg{width:19px;height:19px}\n.navtoggle .ic-x{display:none}\n.navtoggle[aria-expanded=\"true\"] .ic-menu{display:none}\n.navtoggle[aria-expanded=\"true\"] .ic-x{display:block}\n\n/* ===================== buttons ===================== */\n.btn{\n  display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:48px;padding:0 1.4rem;\n  font-family:var(--font-display);font-weight:600;font-size:var(--fs-sm);letter-spacing:-.005em;\n  border-radius:var(--r-btn);border:1px solid transparent;background:var(--ink);color:var(--on-d);\n  text-decoration:none;cursor:pointer;white-space:nowrap;\n  transition:transform var(--feedback) var(--ease),box-shadow var(--feedback) var(--ease),background var(--feedback) var(--ease),border-color var(--feedback) var(--ease),color var(--feedback) var(--ease);\n}\n.btn:hover{transform:translateY(-1px)}\n.btn:active{transform:translateY(0) scale(.98);transition-duration:.08s}\n.btn--lg{min-height:54px;padding:0 1.6rem;font-size:var(--fs-body)}\n@media (max-width:480px){ .btn{white-space:normal;text-align:center;line-height:1.3;padding-block:.55rem} .btn--lg{padding-inline:1.1rem} }\n/* primary CTA: solid brick red, white text (6.20:1), deep brick on hover (7.96:1) */\n.btn--primary{background:linear-gradient(150deg,#BF2924,var(--red));color:var(--on-d);border-color:rgba(255,255,255,.12);box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 5px 16px -7px rgba(185,28,28,.5)}\n.btn--primary:hover{background:var(--red-2);box-shadow:inset 0 1px 0 rgba(255,255,255,.15),0 10px 24px -8px rgba(185,28,28,.45)}\n.btn:disabled{cursor:wait;opacity:.7;transform:none;box-shadow:none}\n.btn--ghost{background:transparent;color:var(--ink);border-color:var(--ui-l)}\n.btn--ghost:hover{border-color:var(--ink);background:var(--paper-3)}\n.btn--ghost-dark,.btn--ghostOnDark{background:transparent;color:var(--on-d);border-color:var(--ui-d)}\n.btn--ghost-dark:hover,.btn--ghostOnDark:hover{border-color:var(--on-d);background:rgba(250,250,250,.06)}\n.btn--onDark{background:var(--on-d);color:var(--ink)}\n.btn__arrow{transition:transform var(--feedback) var(--ease)}\n.btn:hover .btn__arrow,.btn:focus-visible .btn__arrow{transform:translateX(2px)}\n\n/* ===================== shared bits ===================== */\n.serif-em{font-family:var(--font-accent);font-style:italic;font-weight:400;letter-spacing:-.01em}\n.sec-head{--head-line:var(--line-strong);max-width:48rem;margin-bottom:clamp(2rem,4vw,3.5rem)}\n.sec-head--center{margin-inline:auto;text-align:center}\n.sec-head p{margin-top:var(--sp-3);font-size:var(--fs-lg);color:var(--ink-muted);line-height:1.55;text-wrap:pretty;max-width:54ch}\n.sec-head--center p{margin-inline:auto}\n\n\n/* ===================================================================\n   HERO: layered charcoal, photo-ready (placeholder), a quiet structural\n   grid behind the lead-path demo and a protected field for the headline.\n   =================================================================== */\n.hero{position:relative;isolation:isolate;overflow:hidden;background:var(--char);color:var(--on-d);padding-block:clamp(3rem,6vw,6rem) clamp(3.5rem,6vw,6rem)}\n.hero__media{\n  position:absolute;inset:0;z-index:-1;pointer-events:none;\n  background:radial-gradient(ellipse at 86% 46%,#261616 0%,#141212 30%,transparent 61%),var(--char);\n}\n.hero__media::after{\n  content:\"\";position:absolute;inset:0;\n  background:linear-gradient(90deg,#0A0A0A 0%,rgba(10,10,10,.96) 34%,transparent 72%),linear-gradient(0deg,#0A0A0A,transparent 28%);\n}\n/* PLACEHOLDER PHOTO: set --hero-photo on .hero to url(data:image/jpeg;base64,...) of a real technician photo.\n   Keep .hero__shade on top of it: it is what holds the headline's contrast. */\n.io .trust__row:not(.in) > li{opacity:0;transform:translateY(var(--reveal-y)) scale(.94)}\n.io .trust__row.in > li{animation:pop .6s var(--ease) backwards}\n.io .trust__row.in > li:nth-child(2){animation-delay:.1s}\n.io .trust__row.in > li:nth-child(3){animation-delay:.2s}\n.io .trust__row.is-static > li{animation:none}\n@keyframes pop{from{opacity:0;transform:translateY(var(--reveal-y)) scale(.94)}to{opacity:1;transform:none}}\n@media (max-width:620px){\n  .trust__row{flex-direction:column;align-items:stretch}\n  .trust__btn{width:100%}\n}\n\n/* ===================== services (stage 3): flagship ads panel, core services, also-available ===================== */\n.svc-sec{position:relative;padding-top:clamp(3.5rem,6vw,6rem);background:var(--paper-2);border-radius:32px 32px 0 0;margin-top:-1px}\n.sic{width:48px;height:48px;flex:none;border-radius:12px;display:grid;place-items:center}\n.sic svg{width:22px;height:22px}\n.sic--sm{width:42px;height:42px;border-radius:11px}\n.sic--sm svg{width:20px;height:20px}\n.sic--d{background:rgba(185,28,28,.16);border:1px solid rgba(216,90,90,.5);color:var(--ember)}\n.sic--l{background:var(--accent-tint);border:1px solid var(--accent-line);color:var(--red)}\n.tag{display:inline-flex;align-items:center;min-height:26px;padding:0 .7rem;border-radius:var(--r-pill);font-size:var(--fs-xs);font-weight:700;letter-spacing:.01em;white-space:nowrap}\n.tag--red{background:var(--red);color:var(--on-d)}\n.tag--soft{background:var(--accent-tint);color:var(--red-2);border:1px solid var(--accent-line)}\n.cq{font-size:var(--fs-sm);font-weight:600;color:var(--ink-muted)}\n.slink{display:inline-flex;align-items:center;gap:.4rem;min-height:44px;font-size:var(--fs-sm);font-weight:700;color:var(--red);text-decoration:none}\n.slink svg{width:14px;height:14px;flex:none;transition:transform var(--feedback) var(--ease)}\n.slink:hover,.slink:focus-visible{text-decoration:underline;text-underline-offset:.22em}\n.slink:hover svg,.slink:focus-visible svg{transform:translateX(2px)}\n.chips{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:var(--sp-4)}\n.chips li{font-size:var(--fs-xs);font-weight:500;color:var(--ink-soft);background:var(--paper-2);border:1px solid var(--line);border-radius:var(--r-pill);padding:.28rem .7rem}\n\n/* flagship: dark, full width, sub-services inside */\n.flag{\n  position:relative;isolation:isolate;overflow:hidden;\n  display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(1.75rem,3.5vw,3rem);\n  padding:clamp(1.75rem,4vw,3rem);border-radius:var(--r-lg);background:var(--char);color:var(--on-d);\n  border:1px solid var(--line-d);box-shadow:var(--shadow-d);\n}\n.flag::before{content:\"\";position:absolute;z-index:-1;left:-18%;top:-45%;width:72%;aspect-ratio:1;border-radius:50%;background:radial-gradient(closest-side,rgba(185,28,28,.26),rgba(185,28,28,0));filter:blur(18px);pointer-events:none}\n.flag__top{display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap}\n.flag h3{margin-top:var(--sp-5);font-size:clamp(1.875rem,1.35rem + 2vw,2.75rem);font-weight:800;letter-spacing:-.024em;color:var(--on-d)}\n.flag__lede{margin-top:var(--sp-4);max-width:36rem;font-size:var(--fs-lg);line-height:1.6;color:var(--on-d2)}\n.flag__list{margin-top:var(--sp-6);display:grid;gap:.75rem}\n.flag__list li{display:grid;grid-template-columns:auto 1fr;gap:.65rem;align-items:start;font-size:var(--fs-sm);color:var(--on-d)}\n.flag__list svg{width:16px;height:16px;margin-top:.25rem;color:var(--ember)}\n.flag__cta{margin-top:var(--sp-7);display:flex;flex-wrap:wrap;align-items:center;gap:var(--sp-3) var(--sp-5)}\n.flag__cta p{font-size:var(--fs-sm);color:var(--on-d2)}\n.flag__subs{display:grid;gap:var(--sp-3);align-content:start}\n.sub{\n  display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--sp-4);align-items:start;\n  padding:var(--sp-5);border-radius:var(--r);background:var(--card-d);border:1px solid var(--line-d);\n  transition:border-color var(--feedback) var(--ease),transform var(--feedback) var(--ease);\n}\n.sub:hover{border-color:#474747;transform:translateY(var(--lift))}\n.sub h4{font-size:1.125rem;font-weight:700;letter-spacing:-.01em;color:var(--on-d)}\n.sub p{margin-top:.35rem;font-size:var(--fs-sm);color:var(--on-d2)}\n\n/* core services: two large white cards */\n.core{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-5);margin-top:var(--sp-5)}\n.scard,.mcard{\n  position:relative;display:flex;flex-direction:column;border-radius:var(--r-lg);background:var(--paper);border:1px solid var(--line);\n  box-shadow:var(--shadow-sm);transition:transform var(--feedback) var(--ease),box-shadow var(--feedback) var(--ease),border-color var(--feedback) var(--ease);\n}\n.scard{padding:clamp(1.5rem,3vw,2.25rem)}\n.scard:hover,.mcard:hover,.scard:focus-within,.mcard:focus-within{transform:translateY(var(--lift));box-shadow:var(--shadow);border-color:var(--line-strong)}\n.scard__top{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3)}\n.scard h3{margin-top:var(--sp-5);font-size:clamp(1.5rem,1.25rem + 1vw,1.875rem);font-weight:800;letter-spacing:-.02em}\n.scard > p{margin-top:var(--sp-3);font-size:var(--fs-body);color:var(--ink-muted);max-width:54ch}\n.card-foot{margin-top:auto;padding-top:var(--sp-5);display:flex;align-items:center;justify-content:space-between;gap:var(--sp-2) var(--sp-4);flex-wrap:wrap}\n.svc-addon{\n  margin-top:var(--sp-5);display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--sp-4);align-items:start;\n  padding:var(--sp-5);border-radius:var(--r);background:var(--char);color:var(--on-d);border:1px solid var(--line-d);\n}\n.svc-addon h4{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;font-size:1.125rem;font-weight:700;color:var(--on-d)}\n.svc-addon p{margin-top:.35rem;font-size:var(--fs-sm);color:var(--on-d2)}\n\n/* receptionist: an example of the text the owner receives (labeled as an example) */\n.svc-example{margin:var(--sp-5) 0 0;padding:var(--sp-5);border-radius:var(--r);background:var(--char);border:1px solid var(--line-d)}\n.svc-example figcaption{font-size:var(--fs-xs);font-weight:600;color:var(--on-d2)}\n.sms{margin-top:var(--sp-3);max-width:30rem;padding:.85rem 1rem;border-radius:16px 16px 16px 4px;background:var(--card-d2);border:1px solid var(--line-d)}\n.sms__from{font-size:var(--fs-xs);color:var(--on-d2)}\n.sms__txt{margin-top:.25rem;font-size:var(--fs-sm);line-height:1.5;color:var(--on-d)}\n\n/* also available: three compact cards */\n.more{margin-top:clamp(2.5rem,5vw,3.5rem)}\n.more > h3{display:flex;align-items:center;gap:1.25rem;font-size:var(--fs-h3);font-weight:800}\n.more > h3::after{content:\"\";height:1px;flex:1;background:var(--line-strong)}\n.more__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--sp-4);margin-top:var(--sp-5)}\n.mcard{padding:var(--sp-6)}\n.mcard h4{margin-top:var(--sp-4);font-size:1.1875rem;font-weight:700;letter-spacing:-.01em}\n.mcard