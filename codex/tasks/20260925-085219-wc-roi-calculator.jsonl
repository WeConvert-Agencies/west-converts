{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '477,487p' weconvert-site/index.html\"","aggregated_output":"  .chatw__btn{width:52px;height:52px}\n  .chatw__btn svg{width:23px;height:23px}\n  .chatw__panel{bottom:66px;max-height:calc(100dvh - 190px - env(safe-area-inset-bottom))}\n}\n\n/* ===================== process — the line draws, each step lights as it passes ===================== */\n#process{padding-block:var(--section-y-short) var(--section-y);background:linear-gradient(180deg,var(--paper-2),var(--paper) 6rem)}\n.steps{position:relative}\n.steps__track{position:absolute;left:0;right:0;top:14px;height:1px;background:var(--line-strong)}\n.steps__fill{position:absolute;inset:0;background:linear-gradient(90deg,var(--accent),var(--accent-2));transform-origin:0 50%;transition:transform 1.4s var(--ease)}\n.io .steps:not(.in) .steps__fill{transform:scaleX(0)}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nimport tempfile\n\npage = Path('weconvert-site/index.html')\noriginal = page.read_text()\nsrc = original\n\ndef replace_once(anchor, replacement):\n    global src\n    assert src.count(anchor) == 1, (anchor[:100], src.count(anchor))\n    src = src.replace(anchor, replacement, 1)\n\ncss = '''/* ===================== ROI calculator ===================== */\n.roi-sec{background:var(--paper-2)}\n.roi{\n  display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(2rem,4vw,4rem);align-items:center;\n  padding:clamp(1.5rem,4vw,3rem);border-radius:var(--r-lg);border:1px solid var(--line-d);\n  background:var(--char);color:var(--on-d);box-shadow:var(--shadow-d);\n}\n.roi__inputs{display:grid;gap:var(--sp-7);min-width:0}\n.roi__control{display:grid;gap:var(--sp-3);min-width:0}\n.roi__head{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:var(--sp-2) var(--sp-4)}\n.roi__head label{font-size:var(--fs-sm);font-weight:600;cursor:pointer}\n.roi__head .roi__readout{color:var(--ember);font-variant-numeric:tabular-nums;white-space:nowrap}\n.roi__field{position:relative;min-width:0}\n.roi__unit{position:absolute;left:var(--sp-4);top:50%;transform:translateY(-50%);color:var(--on-d2);pointer-events:none}\n.roi__field--percent .roi__unit{left:auto;right:var(--sp-4)}\n.roi__number{\n  display:block;width:100%;min-width:0;min-height:52px;padding:.65rem var(--sp-4) .65rem 2.25rem;\n  border:1px solid var(--ui-d);border-radius:var(--r);background:var(--card-d);color:var(--on-d);\n  font:inherit;font-variant-numeric:tabular-nums;caret-color:var(--ember);color-scheme:dark;\n}\n.roi__field--percent .roi__number{padding-left:var(--sp-4);padding-right:2.5rem}\n.roi__range{display:block;width:100%;min-width:44px;height:44px;margin:0;padding:0;appearance:none;-webkit-appearance:none;background:transparent;accent-color:var(--ember);cursor:pointer}\n.roi__range::-webkit-slider-runnable-track{height:6px;border-radius:var(--r-pill);background:var(--ui-d)}\n.roi__range::-webkit-slider-thumb{appearance:none;-webkit-appearance:none;width:24px;height:24px;margin-top:-9px;border:2px solid var(--on-d);border-radius:50%;background:var(--ember)}\n.roi__range::-moz-range-track{height:6px;border-radius:var(--r-pill);background:var(--ui-d)}\n.roi__range::-moz-range-thumb{width:20px;height:20px;border:2px solid var(--on-d);border-radius:50%;background:var(--ember)}\n.roi :focus-visible{outline-color:var(--on-d)}\n.roi__result{min-width:0;padding-left:clamp(1.5rem,3vw,3rem);border-left:1px solid var(--line-d)}\n.roi__label{font-size:var(--fs-xs);font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--on-d2);max-width:36ch}\n.roi__value{margin-top:var(--sp-4);font-family:var(--font-display);font-size:clamp(2rem,3.8vw,3.5rem);font-weight:800;letter-spacing:-.035em;line-height:1.15;font-variant-numeric:tabular-nums}\n.roi__value span{display:inline-block;white-space:nowrap}\n.roi__note{margin-top:var(--sp-5);font-size:var(--fs-sm);line-height:1.6;color:var(--on-d2);max-width:54ch}\n.roi__result .btn{margin-top:var(--sp-6);max-width:100%;white-space:normal;text-align:center}\n.roi__result .btn__arrow{flex:none}\n@media (max-width:900px){\n  .roi{grid-template-columns:minmax(0,1fr)}\n  .roi__result{padding:var(--sp-6) 0 0;border-left:0;border-top:1px solid var(--line-d)}\n}\n@media (max-width:480px){\n  .roi__result .btn{width:100%}\n}\n\n'''\ncss_anchor = '/* ===================== process — the line draws, each step lights as it passes ===================== */'\nreplace_once(css_anchor, css + css_anchor)\n\nhtml = '''<\"'!-- ============================ ROI CALCULATOR ============================ -->\n<section class=\"section roi-sec\" id=\"roi\">\n  <div class=\"container\">\n    <p class=\"eyebrow section-label\">02 / Let&rsquo;s do the math</p>\n    <div class=\"sec-head\">\n      <h2>What Are New Leads Actually Worth To You?</h2>\n      <p>Adjust the two numbers below to match your business.</p>\n    </div>\n\n    <div class=\"roi\">\n      <div class=\"roi__inputs\">\n        <div class=\"roi__control\">\n          <div class=\"roi__head\">\n            <label for=\"roi-job-range\" id=\"roi-job-label\">Average job value</label>\n            <label class=\"roi__readout\" for=\"roi-job-number\" id=\"roi-job-readout\">$2,500</label>\n          </div>\n          <div class=\"roi__field\">\n            <span class=\"roi__unit\" aria-hidden=\"true\">$</span>\n            <input class=\"roi__number\" id=\"roi-job-number\" type=\"number\" min=\"250\" max=\"15000\" step=\"1\" value=\"2500\" aria-labelledby=\"roi-job-label\">\n          </div>\n          <input class=\"roi__range\" id=\"roi-job-range\" type=\"range\" min=\"250\" max=\"15000\" step=\"250\" value=\"2500\" aria-valuemin=\"250\" aria-valuemax=\"15000\" aria-valuenow=\"2500\" aria-valuetext=\"$2,500\">\n        </div>\n        <div class=\"roi__control\">\n          <div class=\"roi__head\">\n            <label for=\"roi-close-range\" id=\"roi-close-label\">How many leads do you close?</label>\n            <label class=\"roi__readout\" for=\"roi-close-number\" id=\"roi-close-readout\">30%</label>\n          </div>\n          <div class=\"roi__field roi__field--percent\">\n            <span class=\"roi__unit\" aria-hidden=\"true\">%</span>\n            <input class=\"roi__number\" id=\"roi-close-number\" type=\"number\" min=\"5\" max=\"80\" step=\"1\" value=\"30\" aria-labelledby=\"roi-close-label\">\n          </div>\n          <input class=\"roi__range\" id=\"roi-close-range\" type=\"range\" min=\"5\" max=\"80\" step=\"5\" value=\"30\" aria-valuemin=\"5\" aria-valuemax=\"80\" aria-valuenow=\"30\" aria-valuetext=\"30%\">\n        </div>\n      </div>\n      <div class=\"roi__result\">\n        <p class=\"roi__label\" id=\"roi-result-label\">Estimated monthly revenue from new leads</p>\n        <p class=\"roi__value\" aria-labelledby=\"roi-result-label\"><span id=\"roi-low\">$3,800</span> – <span id=\"roi-high\">$10,500</span></p>\n        <p class=\"roi__note\">Based on the 5 to 14 leads a month we&rsquo;ve seen at our recommended ad spend. This is an estimate from the numbers you entered, not a promise of results — your market, season, and how fast you return calls all move it.</p>\n        <a class=\"btn btn--primary btn--lg\" href=\"#start\">Book Your Free Strategy Call <svg class=\"btn__arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n      </div>\n      <p class=\"sr-only\" id=\"roi-announcement\" aria-live=\"polite\" aria-atomic=\"true\">Estimated monthly revenue from new leads: $3,800 to $10,500</p>\n    </div>\n  </div>\n</section>\n\n'\"'''\nhtml_anchor = '<\"'!-- ============================ PROCESS ============================ -->'\"'\nreplace_once(html_anchor, html + html_anchor)\nfor old_number, label in enumerate(['How it works', 'Why us', 'About West Converts', 'Our clients', 'Your questions', 'Let’s talk'], 2):\n    replace_once(f'section-label\\\">{old_number:02d} / {label}</p>', f'section-label\\\">{old_number + 1:02d} / {label}</p>')\n\njs = '''  /* ---------- ROI calculator: typed values stay independent of slider steps ---------- */\n  var roi = document.getElementById(\\\"roi\\\");\n  if (roi){\n    const LEADS_LOW = 5;\n    const LEADS_HIGH = 14;\n    var roiCurrency = new Intl.NumberFormat(\\\"en-US\\\", {style:\\\"currency\\\", currency:\\\"USD\\\", maximumFractionDigits:0});\n    var roiLow = document.getElementById(\\\"roi-low\\\");\n    var roiHigh = document.getElementById(\\\"roi-high\\\");\n    var roiAnnouncement = document.getElementById(\\\"roi-announcement\\\");\n    var roiTimer;\n    var roiControls = [\n      {range:document.getElementById(\\\"roi-job-range\\\"), number:document.getElementById(\\\"roi-job-number\\\"), readout:document.getElementById(\\\"roi-job-readout\\\"), format:function(value){ return roiCurrency.format(value); }},\n      {range:document.getElementById(\\\"roi-close-range\\\"), number:document.getElementById(\\\"roi-close-number\\\"), readout:document.getElementById(\\\"roi-close-readout\\\"), format:function(value){ return value + \\\"%\\\"; }}\n    ];\n    var roiValue = function(control){\n      var value = control.number.valueAsNumber;\n      if (\"'!Number.isFinite(value)) value = Number(control.number.defaultValue);\n      return Math.min(Number(control.number.max), Math.max(Number(control.number.min), value));\n    };\n    var renderRoi = function(announce){\n      var avgJobValue = roiValue(roiControls[0]);\n      var closeRatePercent = roiValue(roiControls[1]);\n      var closed = closeRatePercent / 100;\n      var low = LEADS_LOW * closed * avgJobValue;\n      var high = LEADS_HIGH * closed * avgJobValue;\n      low = Math.round(low / 100) * 100;\n      high = Math.round(high / 100) * 100;\n      roiLow.textContent = roiCurrency.format(low);\n      roiHigh.textContent = roiCurrency.format(high);\n      clearTimeout(roiTimer);\n      if (announce) roiTimer = setTimeout(function(){\n        roiAnnouncement.textContent = \"Estimated monthly revenue from new leads: \" + roiCurrency.format(low) + \" to \" + roiCurrency.format(high);\n      }, 300);\n    };\n    var syncRoi = function(control){\n      var value = roiValue(control);\n      control.range.value = String(value);\n      control.readout.textContent = control.format(value);\n      /* The native range may snap; its ARIA must describe its actual position. */\n      control.range.setAttribute(\"aria-valuemin\", control.range.min);\n      control.range.setAttribute(\"aria-valuemax\", control.range.max);\n      control.range.setAttribute(\"aria-valuenow\", control.range.value);\n      control.range.setAttribute(\"aria-valuetext\", control.format(Number(control.range.value)));\n    };\n    each(roiControls, function(control){\n      var fromRange = function(){\n        control.number.value = control.range.value;\n        syncRoi(control);\n        renderRoi(true);\n      };\n      var fromNumber = function(){\n        syncRoi(control);\n        renderRoi(true);\n      };\n      var normalizeNumber = function(){\n        control.number.value = String(roiValue(control));\n        fromNumber();\n      };\n      control.range.addEventListener(\"input\", fromRange);\n      control.range.addEventListener(\"change\", fromRange);\n      control.number.addEventListener(\"input\", fromNumber);\n      control.number.addEventListener(\"change\", normalizeNumber);\n      control.number.addEventListener(\"blur\", normalizeNumber);\n      syncRoi(control);\n    });\n    renderRoi(false);\n  }\n\n'\"'''\njs_anchor = '  /* ---------- sticky header ---------- */'\nreplace_once(js_anchor, js + js_anchor)\n\n# Confirm each addition is wired at its intended boundary, and all other source is preserved.\nassert css + css_anchor in src\nassert html + html_anchor in src\nassert js + js_anchor in src\nassert 'control.number.addEventListener(\\\"input\\\", fromNumber);' in js\nassert 'control.number.addEventListener(\\\"change\\\", normalizeNumber);' in js\nassert 'control.number.addEventListener(\\\"blur\\\", normalizeNumber);' in js\nassert 'control.range.addEventListener(\\\"input\\\", fromRange);' in js\nassert 'control.range.setAttribute(\\\"aria-valuenow\\\", control.range.value);' in js\nassert 'if (announce) roiTimer = setTimeout(function(){' in js and '}, 300);' in js\nrestored = src.replace(css, '', 1).replace(html, '', 1).replace(js, '', 1)\nfor old_number, label in enumerate(['How it works', 'Why us', 'About West Converts', 'Our clients', 'Your questions', 'Let’s talk'], 2):\n    updated = f'section-label\\\">{old_number + 1:02d} / {label}</p>'\n    assert restored.count(updated) == 1\n    restored = restored.replace(updated, f'section-label\\\">{old_number:02d} / {label}</p>', 1)\nassert restored == original, 'Unexpected edit outside ROI and section label numbers'\nassert page.read_text() == original, 'File changed during edit'\nwith tempfile.NamedTemporaryFile('w', encoding='utf-8', dir=page.parent, prefix='.index-roi-', delete=False) as staged:\n    staged.write(src)\n    staged_path = Path(staged.name)\nos.chmod(staged_path, page.stat().st_mode)\nos.replace(staged_path, page)\nprint('Updated index.html atomically; placement, event wiring, and unrelated-source preservation assertions passed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os\nimport tempfile\n\npage = Path('weconvert-site/index.html')\noriginal = page.read_text()\nsrc = original\n\ndef replace_once(anchor, replacement):\n    global src\n    assert src.count(anchor) == 1, (anchor[:100], src.count(anchor))\n    src = src.replace(anchor, replacement, 1)\n\ncss = '''/* ===================== ROI calculator ===================== */\n.roi-sec{background:var(--paper-2)}\n.roi{\n  display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(2rem,4vw,4rem);align-items:center;\n  padding:clamp(1.5rem,4vw,3rem);border-radius:var(--r-lg);border:1px solid var(--line-d);\n  background:var(--char);color:var(--on-d);box-shadow:var(--shadow-d);\n}\n.roi__inputs{display:grid;gap:var(--sp-7);min-width:0}\n.roi__control{display:grid;gap:var(--sp-3);min-width:0}\n.roi__head{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:var(--sp-2) var(--sp-4)}\n.roi__head label{font-size:var(--fs-sm);font-weight:600;cursor:pointer}\n.roi__head .roi__readout{color:var(--ember);font-variant-numeric:tabular-nums;white-space:nowrap}\n.roi__field{position:relative;min-width:0}\n.roi__unit{position:absolute;left:var(--sp-4);top:50%;transform:translateY(-50%);color:var(--on-d2);pointer-events:none}\n.roi__field--percent .roi__unit{left:auto;right:var(--sp-4)}\n.roi__number{\n  display:block;width:100%;min-width:0;min-height:52px;padding:.65rem var(--sp-4) .65rem 2.25rem;\n  border:1px solid var(--ui-d);border-radius:var(--r);background:var(--card-d);color:var(--on-d);\n  font:inherit;font-variant-numeric:tabular-nums;caret-color:var(--ember);color-scheme:dark;\n}\n.roi__field--percent .roi__number{padding-left:var(--sp-4);padding-right:2.5rem}\n.roi__range{display:block;width:100%;min-width:44px;height:44px;margin:0;padding:0;appearance:none;-webkit-appearance:none;background:transparent;accent-color:var(--ember);cursor:pointer}\n.roi__range::-webkit-slider-runnable-track{height:6px;border-radius:var(--r-pill);background:var(--ui-d)}\n.roi__range::-webkit-slider-thumb{appearance:none;-webkit-appearance:none;width:24px;height:24px;margin-top:-9px;border:2px solid var(--on-d);border-radius:50%;background:var(--ember)}\n.roi__range::-moz-range-track{height:6px;border-radius:var(--r-pill);background:var(--ui-d)}\n.roi__range::-moz-range-thumb{width:20px;height:20px;border:2px solid var(--on-d);border-radius:50%;background:var(--ember)}\n.roi :focus-visible{outline-color:var(--on-d)}\n.roi__result{min-width:0;padding-left:clamp(1.5rem,3vw,3rem);border-left:1px solid var(--line-d)}\n.roi__label{font-size:var(--fs-xs);font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--on-d2);max-width:36ch}\n.roi__value{margin-top:var(--sp-4);font-family:var(--font-display);font-size:clamp(2rem,3.8vw,3.5rem);font-weight:800;letter-spacing:-.035em;line-height:1.15;font-variant-numeric:tabular-nums}\n.roi__value span{display:inline-block;white-space:nowrap}\n.roi__note{margin-top:var(--sp-5);font-size:var(--fs-sm);line-height:1.6;color:var(--on-d2);max-width:54ch}\n.roi__result .btn{margin-top:var(--sp-6);max-width:100%;white-space:normal;text-align:center}\n.roi__result .btn__arrow{flex:none}\n@media (max-width:900px){\n  .roi{grid-template-columns:minmax(0,1fr)}\n  .roi__result{padding:var(--sp-6) 0 0;border-left:0;border-top:1px solid var(--line-d)}\n}\n@media (max-width:480px){\n  .roi__result .btn{width:100%}\n}\n\n'''\ncss_anchor = '/* ===================== process — the line draws, each step lights as it passes ===================== */'\nreplace_once(css_anchor, css + css_anchor)\n\nhtml = '''<\"'!-- ============================ ROI CALCULATOR ============================ -->\n<section class=\"section roi-sec\" id=\"roi\">\n  <div class=\"container\">\n    <p class=\"eyebrow section-label\">02 / Let&rsquo;s do the math</p>\n    <div class=\"sec-head\">\n      <h2>What Are New Leads Actually Worth To You?</h2>\n      <p>Adjust the two numbers below to match your business.</p>\n    </div>\n\n    <div class=\"roi\">\n      <div class=\"roi__inputs\">\n        <div class=\"roi__control\">\n          <div class=\"roi__head\">\n            <label for=\"roi-job-range\" id=\"roi-job-label\">Average job value</label>\n            <label class=\"roi__readout\" for=\"roi-job-number\" id=\"roi-job-readout\">$2,500</label>\n          </div>\n          <div class=\"roi__field\">\n            <span class=\"roi__unit\" aria-hidden=\"true\">$</span>\n            <input class=\"roi__number\" id=\"roi-job-number\" type=\"number\" min=\"250\" max=\"15000\" step=\"1\" value=\"2500\" aria-labelledby=\"roi-job-label\">\n          </div>\n          <input class=\"roi__range\" id=\"roi-job-range\" type=\"range\" min=\"250\" max=\"15000\" step=\"250\" value=\"2500\" aria-valuemin=\"250\" aria-valuemax=\"15000\" aria-valuenow=\"2500\" aria-valuetext=\"$2,500\">\n        </div>\n        <div class=\"roi__control\">\n          <div class=\"roi__head\">\n            <label for=\"roi-close-range\" id=\"roi-close-label\">How many leads do you close?</label>\n            <label class=\"roi__readout\" for=\"roi-close-number\" id=\"roi-close-readout\">30%</label>\n          </div>\n          <div class=\"roi__field roi__field--percent\">\n            <span class=\"roi__unit\" aria-hidden=\"true\">%</span>\n            <input class=\"roi__number\" id=\"roi-close-number\" type=\"number\" min=\"5\" max=\"80\" step=\"1\" value=\"30\" aria-labelledby=\"roi-close-label\">\n          </div>\n          <input class=\"roi__range\" id=\"roi-close-range\" type=\"range\" min=\"5\" max=\"80\" step=\"5\" value=\"30\" aria-valuemin=\"5\" aria-valuemax=\"80\" aria-valuenow=\"30\" aria-valuetext=\"30%\">\n        </div>\n      </div>\n      <div class=\"roi__result\">\n        <p class=\"roi__label\" id=\"roi-result-label\">Estimated monthly revenue from new leads</p>\n        <p class=\"roi__value\" aria-labelledby=\"roi-result-label\"><span id=\"roi-low\">$3,800</span> – <span id=\"roi-high\">$10,500</span></p>\n        <p class=\"roi__note\">Based on the 5 to 14 leads a month we&rsquo;ve seen at our recommended ad spend. This is an estimate from the numbers you entered, not a promise of results — your market, season, and how fast you return calls all move it.</p>\n        <a class=\"btn btn--primary btn--lg\" href=\"#start\">Book Your Free Strategy Call <svg class=\"btn__arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n      </div>\n      <p class=\"sr-only\" id=\"roi-announcement\" aria-live=\"polite\" aria-atomic=\"true\">Estimated monthly revenue from new leads: $3,800 to $10,500</p>\n    </div>\n  </div>\n</section>\n\n'\"'''\nhtml_anchor = '<\"'!-- ============================ PROCESS ============================ -->'\"'\nreplace_once(html_anchor, html + html_anchor)\nfor old_number, label in enumerate(['How it works', 'Why us', 'About West Converts', 'Our clients', 'Your questions', 'Let’s talk'], 2):\n    replace_once(f'section-label\\\">{old_number:02d} / {label}</p>', f'section-label\\\">{old_number + 1:02d} / {label}</p>')\n\njs = '''  /* ---------- ROI calculator: typed values stay independent of slider steps ---------- */\n  var roi = document.getElementById(\\\"roi\\\");\n  if (roi){\n    const LEADS_LOW = 5;\n    const LEADS_HIGH = 14;\n    var roiCurrency = new Intl.NumberFormat(\\\"en-US\\\", {style:\\\"currency\\\", currency:\\\"USD\\\", maximumFractionDigits:0});\n    var roiLow = document.getElementById(\\\"roi-low\\\");\n    var roiHigh = document.getElementById(\\\"roi-high\\\");\n    var roiAnnouncement = document.getElementById(\\\"roi-announcement\\\");\n    var roiTimer;\n    var roiControls = [\n      {range:document.getElementById(\\\"roi-job-range\\\"), number:document.getElementById(\\\"roi-job-number\\\"), readout:document.getElementById(\\\"roi-job-readout\\\"), format:function(value){ return roiCurrency.format(value); }},\n      {range:document.getElementById(\\\"roi-close-range\\\"), number:document.getElementById(\\\"roi-close-number\\\"), readout:document.getElementById(\\\"roi-close-readout\\\"), format:function(value){ return value + \\\"%\\\"; }}\n    ];\n    var roiValue = function(control){\n      var value = control.number.valueAsNumber;\n      if (\"'!Number.isFinite(value)) value = Number(control.number.defaultValue);\n      return Math.min(Number(control.number.max), Math.max(Number(control.number.min), value));\n    };\n    var renderRoi = function(announce){\n      var avgJobValue = roiValue(roiControls[0]);\n      var closeRatePercent = roiValue(roiControls[1]);\n      var closed = closeRatePercent / 100;\n      var low = LEADS_LOW * closed * avgJobValue;\n      var high = LEADS_HIGH * closed * avgJobValue;\n      low = Math.round(low / 100) * 100;\n      high = Math.round(high / 100) * 100;\n      roiLow.textContent = roiCurrency.format(low);\n      roiHigh.textContent = roiCurrency.format(high);\n      clearTimeout(roiTimer);\n      if (announce) roiTimer = setTimeout(function(){\n        roiAnnouncement.textContent = \"Estimated monthly revenue from new leads: \" + roiCurrency.format(low) + \" to \" + roiCurrency.format(high);\n      }, 300);\n    };\n    var syncRoi = function(control){\n      var value = roiValue(control);\n      control.range.value = String(value);\n      control.readout.textContent = control.format(value);\n      /* The native range may snap; its ARIA must describe its actual position. */\n      control.range.setAttribute(\"aria-valuemin\", control.range.min);\n      control.range.setAttribute(\"aria-valuemax\", control.range.max);\n      control.range.setAttribute(\"aria-valuenow\", control.range.value);\n      