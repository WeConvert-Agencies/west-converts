.faq{width:100%;max-width:none}\n}\n@media (max-width:1040px){\n  .hero__inner{grid-template-columns:1fr}\n  .hero h1{max-width:17ch}\n  .hero__visual{width:100%;max-width:38rem;justify-self:center}\n  .flow{max-width:none}\n  .hero__glow{width:120vw;right:-40%}\n  .hero__media{background:linear-gradient(180deg,var(--char) 55%,var(--char-2) 78%,var(--char))}\n  .hero__shade::after{inset:45% 0 0 35%}\n  .why{grid-template-columns:1fr;gap:var(--sp-7)}\n  .cmp .ic svg{margin-top:.2rem}\n  .faq__a p{padding-right:.25rem}\n  .faq__q{font-size:1.125rem;gap:var(--sp-3)}\n  .hero__ctas{margin-top:var(--sp-6)}\n}\n@media (max-width:420px){\n  .flow__head{flex-wrap:wrap;gap:var(--sp-2)}\n  .flow__k{flex-wrap:wrap;gap:.15rem var(--sp-2)}\n  .flow__foot{flex-wrap:wrap}\n  .flow__src{text-align:left}\n  .flag{padding:var(--sp-5)}\n  .form{padding:var(--sp-5)}\n}\n\n@media (max-width:1040px) and (min-width:701px){\n  .hero__inner{grid-template-columns:1.08fr 1fr;gap:2rem}\n  .hero h1{font-size:clamp(2.7rem,5.4vw,3.6rem)}\n  .hero__lede{font-size:1rem}\n  .hero__ctas{gap:.7rem;margin-top:1.5rem}\n  .hero__ctas .btn{font-size:.875rem;width:100%}\n  .flow{padding:1rem}\n  .flow__head{flex-wrap:wrap}\n  .flow__step{grid-template-columns:32px minmax(0,1fr);gap:.6rem}\n  .flow__ic{width:32px;height:32px;border-radius:9px}\n  .flow__rail{left:16px}\n  .flow__step > div{padding:.65rem .7rem}\n  .flow__k{flex-wrap:wrap;gap:.1rem}\n  .flow__src{text-align:left}\n  .flow__foot{flex-wrap:wrap}\n}\n/* ===================== reduced motion ===================== */\n/* Fewer, gentler: drop spatial movement and loops, keep color/opacity feedback. */\n@media (prefers-reduced-motion:reduce){\n  html{scroll-behavior:auto}\n  .js .hero .up,.js .hero h1.up{animation:none;opacity:1;transform:none}\n  .hero__stage{transform:none;transition:none}\n  [data-reveal].reveal-ready{opacity:1;transform:none;transition:none}\n  .nav-ready .nav,.preview-switch button,.flow__fill,.flow__ic,.flow__v,[data-f],.flow__step > div{transition:none}\n  .flow.is-swapping [data-f]{opacity:1;filter:none}\n  .scard--receptionist:hover .voice-visual i{animation:none}\n  .hero__glow,.cta__glow{animation:none}\n  .js .hero .up{transform:none;filter:none;animation-duration:.25s}\n  .mcta{transition:none}\n  .chatw,.chatw__panel{transition:none;animation:none}\n  .sub:hover,.scard:hover,.mcard:hover,.scard:focus-within,.mcard:focus-within,.chatw__btn:hover{transform:none}\n  .io .trust__row:not(.in) > li,.io .trust__row.in > li{animation:none;opacity:1;transform:none}\n  .trust__item:hover{transform:none}\n  .btn:hover,.btn:active,.btn:hover .btn__arrow,.btn:focus-visible .btn__arrow,.svc__more:hover svg{transform:none}\n  .slink:hover svg,.slink:focus-visible svg,.invite:hover svg,.nav a:active,.faq__q:active{transform:none}\n  .svc::before{transform:none}\n  .svc:hover .svc__name svg{transform:none}\n  .bar span,.steps__fill,.faq__a,.faq__ic,.nav__ind{transition:none}\n}\n@media print{.header,.cta__glow,.hero__media,.mcta{display:none}}\n  </div>\n  <!-- PLACEHOLDER PHOTO: set --hero-photo on .hero to a real technician photo (see .hero__photo in the CSS). -->\n\n  <div class=\"container hero__inner\">\n    <div class=\"hero__copy\">\n      <p class=\"eyebrow up\" style=\"--d:0ms\">Ads · Websites · Automation</p>\n      <h1 class=\"up\" style=\"--d:70ms\">Helping your trade business get more <span class=\"hl\">booked jobs</span>.</h1>\n      <p class=\"hero__lede up\" style=\"--d:140ms\">Meta and Google ads are what we do best — backed by the websites and AI receptionists that turn every click into a call. Built for HVAC, roofing, plumbing and electrical businesses who want a straight answer, not a sales pitch.</p>\n      <div class=\"hero__ctas up\" style=\"--d:220ms\">\n        <a class=\"btn btn--primary btn--lg\" href=\"#start\">\n          Book Your Free Strategy Call\n          <svg class=\"btn__arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n        </a>\n        <a class=\"btn btn--ghost-dark btn--lg\" href=\"#process\">See how it works</a>\n      </div>\n    </div>\n      <li class=\"trust__item\"><span class=\"trust__ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg></span>Calls and leads go straight to you</li>\n    </ul>\n  </div>\n</section>\n\n<!-- ============================ SERVICES ============================ -->\n<section class=\"section svc-sec\" id=\"services\">\n  <div class=\"container\">\n    <p class=\"eyebrow section-label\">01 / Services</p>\n    <div class=\"sec-head\">\n      <h2>Everything that turns a search into a booked job.</h2>\n      <p>Ads are what we do best. Everything else here exists to make those ads pay off: the page they land on, the phone that gets answered, and the listing people check before they call.</p>\n    </div>\n\n    <!-- Flagship: ads lead, visually and in order -->\n    <article class=\"flag\" data-reveal>\n      <div class=\"flag__main\">\n        <div class=\"flag__top\"><span class=\"sic sic--d\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 15v-4a2 2 0 012-2h2l7-4v16l-7-4H5a2 2 0 01-2-2z\"/><path d=\"M18 9.5a4 4 0 010 5\"/></svg></span><span class=\"tag tag--red\">Flagship service</span></div>\n        <h3>Meta &amp; Google Ads</h3>\n        <p class=\"flag__lede\">Paid ads on Facebook, Instagram and Google Search, aimed at the jobs you want more of in the areas you actually serve. We build the campaigns, watch the numbers and adjust every month so your budget goes where the calls are.</p>\n        <ul class=\"flag__list\">\n          <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>Campaign strategy built around the jobs you want more of</li>\n          <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>Facebook, Instagram and Google Search</li>\n          <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>Targeted to your service area</li>\n          <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>Adjusted every month, reported in plain English</li>\n        </ul>\n        <div class=\"flag__cta\">\n          <a class=\"btn btn--primary btn--lg\" href=\"#start\">Book Your Free Strategy Call <svg class=\"btn__arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n          <p>Custom quote, based on your market and goals.</p>\n        </div>\n      </div>\n      <div class=\"flag__subs\">\n          <div class=\"sub\"><span class=\"sic sic--d sic--sm\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2.5\"/><path d=\"M10 9.5v5l4.5-2.5z\"/></svg></span><div><h4>Ad Creative</h4><p>Graphics and short videos for your campaigns, built from your real jobs, trucks and crew.</p></div></div>\n          <div class=\"sub\"><span class=\"sic sic--d sic--sm\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 3v18h18\"/><path d=\"M7 15l4-4 3 3 5-6\"/></svg></span><div><h4>Tracking &amp; Reporting</h4><p>Performance analytics and a plain-English monthly report: what you spent, what came in, and what we&rsquo;re changing. AI-assisted targeting and reporting help spot what&rsquo;s working sooner.</p></div></div>\n          <div class=\"sub\"><span class=\"sic sic--d sic--sm\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2.5\"/><path d=\"M3 9h18M8 13h8M8 16.5h5\"/></svg></span><div><h4>Landing Pages</h4><p>The page each ad points to, built for one job: turning a click into a call. Separate from a full website build, so ads can run before a redesign.</p></div></div>\n      </div>\n    </article>\n        <div class=\"card-foot\"><span class=\"cq\">Custom quote</span><a class=\"slink\" href=\"#start\">Book Your Free Strategy Call <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a></div>\n      </article>\n    </div>\n\n    <div class=\"more\" data-reveal>\n      <h3>Also available</h3>\n      <div class=\"more__grid\">\n        <article class=\"mcard\"><span class=\"sic sic--l sic--sm\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s7-5.5 7-11a7 7 0 10-14 0c0 5.5 7 11 7 11z\"/><circle cx=\"12\" cy=\"10\" r=\"2.6\"/></svg></span><h4>Google Business Profile &amp; Local SEO</h4><p>Show up when someone searches your trade plus your town, in the map pack and the regular results. It all stays in your name.</p><div class=\"card-foot\"><span class=\"cq\">Custom quote</span><a class=\"slink\" href=\"#start\">Ask on your strategy call <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a></div></article>\n        <article class=\"mcard\" id=\"brand-strategy\"><span class=\"sic sic--l sic--sm\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 17l6-6 4 4 8-8\"/><path d=\"M14 7h7v7\"/></svg></span><h4>Brand &amp; Growth Strategy</h4><p>A clear plan for where your business goes next: how you stand apart, what your brand says, which services to lead with, and where your marketing money should go.</p><div class=\"card-foot\"><span class=\"cq\">Custom quote</span><a class=\"slink\" href=\"#start\">Ask on your strategy call <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a></div></article>\n        <article class=\"mcard\"><span class=\"sic sic--l sic--sm\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 19l7-7 3 3-7 7-3-3z\"/><path d=\"M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z\"/><path d=\"M2 2l7.6 7.6\"/><circle cx=\"11\" cy=\"11\" r=\"2\"/></svg></span><h4>Logo Design</h4><p>A clean mark that reads on a truck door, a yard sign and a phone screen, delivered in every file format you&rsquo;ll need.</p><div class=\"card-foot\"><span class=\"cq\">Custom quote</span><a class=\"slink\" href=\"#start\">Ask on your strategy call <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a></div></article>\n      </div>\n    </div>\n\n    <div class=\"svc-cta\">\n      <p>Not sure where to start?<span>Tell us about your business and we&rsquo;ll recommend what fits on a free strategy call. No pitch deck.</span></p>\n      <a class=\"btn btn--primary btn--lg\" href=\"#start\">Book Your Free Strategy Call <svg class=\"btn__arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n    </div>\n  </div>\n</section>\n\n<!-- ============================ PROCESS ============================ -->\n<section class=\"section\" id=\"process\">\n  <div class=\"container\">\n    <p class=\"eyebrow section-label\">02 / How it works</p>\n    <div class=\"sec-head\">\n      <h2>From first call to live ads, without the runaround.</h2>\n      <p>Four steps from the first call to leads coming in.</p>\n    </div>\n\n    <div class=\"steps\">\n      <span class=\"steps__track\" aria-hidden=\"true\"><span class=\"steps__fill\"></span></span>\n      <ol class=\"steps__list\">\n        <li class=\"step\">\n          <span class=\"step__node\" aria-hidden=\"true\">1</span>\n          <h3>We learn the jobs you want.</h3>\n          <p>Which work pays best, which towns you'll actually drive to, and how much you can take on each week. It takes one short call.</p>\n          <p class=\"step__time\">One short call</p>\n        </li>\n","exit_code":0,"status":"completed"}}
