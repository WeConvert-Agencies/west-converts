px}\n <!-- ============================ WHY US ============================ -->\n <section class=\"section why-sec\" id=\"why\">\n   <div class=\"container\">\n-    <p class=\"eyebrow section-label\">03 / Why us</p>\n+    <p class=\"eyebrow section-label\">04 / Why us</p>\n     <div class=\"sec-head\">\n       <h2>You&rsquo;ve probably been burned by an agency already.</h2>\n       <p>Agencies that go quiet after the invoice clears. Ad budgets that disappear with nothing to show for it. Here&rsquo;s how we set this up differently.</p>\n@@ -1545,7 +1632,7 @@ a{text-underline-offset:.22em;text-decoration-thickness:1px}\n   <div class=\"container\">\n     <div class=\"founder\" data-reveal>\n       <div>\n-        <p class=\"eyebrow section-label\">04 / About West Converts</p>\n+        <p class=\"eyebrow section-label\">05 / About West Converts</p>\n         <h2 id=\"about-title\">Founder-led, from the first call on.</h2>\n         <blockquote class=\"founder__quote\">&ldquo;We&rsquo;d rather give you a straight answer than walk you through a proposal. That&rsquo;s the whole pitch.&rdquo;</blockquote>\n       </div>\n@@ -1565,7 +1652,7 @@ a{text-underline-offset:.22em;text-decoration-thickness:1px}\n <!-- ============================ CLIENTS ============================ -->\n <section class=\"clients\" id=\"clients\" aria-labelledby=\"clients-title\">\n   <div class=\"container\">\n-    <p class=\"eyebrow section-label\">05 / Our clients</p>\n+    <p class=\"eyebrow section-label\">06 / Our clients</p>\n     <h2 id=\"clients-title\">You&rsquo;re in good company.</h2>\n \n     <!-- Client logos. Add each new client as another <li> (white or light logo on a transparent PNG, base64-inlined).\n@@ -1595,7 +1682,7 @@ a{text-underline-offset:.22em;text-decoration-thickness:1px}\n <section class=\"section section--tint\" id=\"faq\">\n   <div class=\"container\">\n     <div class=\"sec-head sec-head--center\">\n-      <p class=\"eyebrow section-label\">06 / Your questions</p>\n+      <p class=\"eyebrow section-label\">07 / Your questions</p>\n       <h2>The questions owners actually ask.</h2>\n     </div>\n     <div class=\"faq\">\n@@ -1777,7 +1864,7 @@ a{text-underline-offset:.22em;text-decoration-thickness:1px}\n   <span class=\"cta__glow\" aria-hidden=\"true\"></span>\n   <div class=\"container cta__inner\">\n     <div>\n-      <p class=\"eyebrow section-label\">07 / Let’s talk</p>\n+      <p class=\"eyebrow section-label\">08 / Let’s talk</p>\n       <h2>Tell us about your business. We&rsquo;ll show you the plan.</h2>\n       <p class=\"cta__lede\">Send your name, number and business. We&rsquo;ll call back with a plan for your ads: which jobs, which towns, and exactly what a month would cost. Need a website too? We&rsquo;ll build you a free demo first.</p>\n       <ul class=\"cta__list\">\n@@ -1926,6 +2013,74 @@ a{text-underline-offset:.22em;text-decoration-thickness:1px}\n   var y = document.getElementById(\"year\");\n   if (y) y.textContent = new Date().getFullYear();\n \n+  /* ---------- ROI calculator: typed values stay independent of slider steps ---------- */\n+  var roi = document.getElementById(\"roi\");\n+  if (roi){\n+    const LEADS_LOW = 5;\n+    const LEADS_HIGH = 14;\n+    var roiCurrency = new Intl.NumberFormat(\"en-US\", {style:\"currency\", currency:\"USD\", maximumFractionDigits:0});\n+    var roiLow = document.getElementById(\"roi-low\");\n+    var roiHigh = document.getElementById(\"roi-high\");\n+    var roiAnnouncement = document.getElementById(\"roi-announcement\");\n+    var roiTimer;\n+    var roiControls = [\n+      {range:document.getElementById(\"roi-job-range\"), number:document.getElementById(\"roi-job-number\"), readout:document.getElementById(\"roi-job-readout\"), format:function(value){ return roiCurrency.format(value); }},\n+      {range:document.getElementById(\"roi-close-range\"), number:document.getElementById(\"roi-close-number\"), readout:document.getElementById(\"roi-close-readout\"), format:function(value){ return value + \"%\"; }}\n+    ];\n+    var roiValue = function(control){\n+      var value = control.number.valueAsNumber;\n+      if (!Number.isFinite(value)) value = Number(control.number.defaultValue);\n+      return Math.min(Number(control.number.max), Math.max(Number(control.number.min), value));\n+    };\n+    var renderRoi = function(announce){\n+      var avgJobValue = roiValue(roiControls[0]);\n+      var closeRatePercent = roiValue(roiControls[1]);\n+      var closed = closeRatePercent / 100;\n+      var low = LEADS_LOW * closed * avgJobValue;\n+      var high = LEADS_HIGH * closed * avgJobValue;\n+      low = Math.round(low / 100) * 100;\n+      high = Math.round(high / 100) * 100;\n+      roiLow.textContent = roiCurrency.format(low);\n+      roiHigh.textContent = roiCurrency.format(high);\n+      clearTimeout(roiTimer);\n+      if (announce) roiTimer = setTimeout(function(){\n+        roiAnnouncement.textContent = \"Estimated monthly revenue from new leads: \" + roiCurrency.format(low) + \" to \" + roiCurrency.format(high);\n+      }, 300);\n+    };\n+    var syncRoi = function(control){\n+      var value = roiValue(control);\n+      control.range.value = String(value);\n+      control.readout.textContent = control.format(value);\n+      /* The native range may snap; its ARIA must describe its actual position. */\n+      control.range.setAttribute(\"aria-valuemin\", control.range.min);\n+      control.range.setAttribute(\"aria-valuemax\", control.range.max);\n+      control.range.setAttribute(\"aria-valuenow\", control.range.value);\n+      control.range.setAttribute(\"aria-valuetext\", control.format(Number(control.range.value)));\n+    };\n+    each(roiControls, function(control){\n+      var fromRange = function(){\n+        control.number.value = control.range.value;\n+        syncRoi(control);\n+        renderRoi(true);\n+      };\n+      var fromNumber = function(){\n+        syncRoi(control);\n+        renderRoi(true);\n+      };\n+      var normalizeNumber = function(){\n+        control.number.value = String(roiValue(control));\n+        fromNumber();\n+      };\n+      control.range.addEventListener(\"input\", fromRange);\n+      control.range.addEventListener(\"change\", fromRange);\n+      control.number.addEventListener(\"input\", fromNumber);\n+      control.number.addEventListener(\"change\", normalizeNumber);\n+      control.number.addEventListener(\"blur\", normalizeNumber);\n+      syncRoi(control);\n+    });\n+    renderRoi(false);\n+  }\n+\n   /* ---------- sticky header ---------- */\n   var header = document.getElementById(\"header\");\n   var onScroll = function(){ header.classList.toggle(\"stuck\", window.scrollY > 8); };\n","exit_code":0,"status":"completed"}}
