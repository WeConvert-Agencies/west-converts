{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1610,2000p' weconvert-site/index.html\"","aggregated_output":"    <svg class=\"ic-chat\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12a8 8 0 01-11.6 7.1L4 20l1-4.6A8 8 0 1121 12z\"/></svg>\n    <svg class=\"ic-x\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>\n  </button>\n</div>\n\n<script>\n(function(){\n  \"use strict\";\n  var doc = document.documentElement;\n  var reduce = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n  var hasIO = \"IntersectionObserver\" in window;\n  var each = function(list, fn){ Array.prototype.forEach.call(list, fn); };\n  if (hasIO) doc.classList.add(\"io\");\n\n  var y = document.getElementById(\"year\");\n  if (y) y.textContent = new Date().getFullYear();\n\n  /* ---------- sticky header ---------- */\n  var header = document.getElementById(\"header\");\n  var onScroll = function(){ header.classList.toggle(\"stuck\", window.scrollY > 8); };\n  onScroll();\n  window.addEventListener(\"scroll\", onScroll, {passive:true});\n\n  /* ---------- mobile nav ---------- */\n  var toggle = document.getElementById(\"navtoggle\");\n  var nav = document.getElementById(\"nav\");\n  var setNav = function(open){\n    header.classList.toggle(\"open\", open);\n    toggle.setAttribute(\"aria-expanded\", String(open));\n    toggle.setAttribute(\"aria-label\", open ? \"Close menu\" : \"Open menu\");\n  };\n  toggle.addEventListener(\"click\", function(){ setNav(toggle.getAttribute(\"aria-expanded\") !== \"true\"); });\n  nav.addEventListener(\"click\", function(e){ if (e.target.closest(\"a\")) setNav(false); });\n  document.addEventListener(\"keydown\", function(e){\n    if (e.key === \"Escape\" && header.classList.contains(\"open\")){ setNav(false); toggle.focus(); }\n  });\n  document.addEventListener(\"click\", function(e){\n    if (header.classList.contains(\"open\") && !e.target.closest(\".header\")) setNav(false);\n  });\n  /* tabbing out of the open menu closes it, so focus never sits behind the overlay */\n  header.addEventListener(\"focusout\", function(e){\n    if (header.classList.contains(\"open\") && e.relatedTarget && !header.contains(e.relatedTarget)) setNav(false);\n  });\n\n  /* ---------- nav: one indicator that travels to the section in view ---------- */\n  var navLinks = Array.prototype.slice.call(nav.querySelectorAll(\"a\"));\n  var ind = nav.querySelector(\".nav__ind\");\n  var current = null;\n  var placeInd = function(a){\n    if (!ind) return;\n    if (!a){ ind.style.opacity = \"0\"; return; }\n    var pad = parseFloat(getComputedStyle(a).paddingLeft) || 0;\n    var w = Math.max(a.offsetWidth - pad * 2, 8);\n    var first = ind.style.opacity !== \"1\";\n    if (first) ind.style.transition = \"none\";\n    ind.style.transform = \"translateX(\" + (a.offsetLeft + pad) + \"px) scaleX(\" + (w / 100) + \")\";\n    if (first){ void ind.offsetWidth; ind.style.transition = \"\"; }\n    ind.style.opacity = \"1\";\n  };\n  var setCurrent = function(a){\n    if (a === current) return;\n    current = a;\n    navLinks.forEach(function(l){ if (l === a) l.setAttribute(\"aria-current\", \"true\"); else l.removeAttribute(\"aria-current\"); });\n    placeInd(a);\n  };\n  if (hasIO){\n    var targets = navLinks.map(function(a){ return document.querySelector(a.getAttribute(\"href\")); });\n    var spy = new IntersectionObserver(function(entries){\n      entries.forEach(function(e){\n        if (!e.isIntersecting) return;\n        if (e.target.id === \"top\"){ setCurrent(null); return; }\n        var i = targets.indexOf(e.target);\n        if (i > -1) setCurrent(navLinks[i]);\n      });\n    }, {rootMargin:\"-45% 0px -50% 0px\"});\n    targets.concat(document.getElementById(\"top\")).forEach(function(t){ if (t) spy.observe(t); });\n  }\n  window.addEventListener(\"resize\", function(){ placeInd(current); });\n\n  /* ---------- moments that play once when they arrive ---------- */\n  var moments = document.querySelectorAll(\".steps\");\n  if (!hasIO || reduce){\n    each(moments, function(el){ el.classList.add(\"in\"); });\n  } else {\n    var arrive = new IntersectionObserver(function(entries){\n      entries.forEach(function(e){\n        if (e.isIntersecting){ e.target.classList.add(\"in\"); arrive.unobserve(e.target); }\n      });\n    }, {rootMargin:\"0px 0px -12% 0px\", threshold:0.2});\n    each(moments, function(el){ arrive.observe(el); });\n  }\n\n  /* ---------- background loops stop when offscreen ---------- */\n  if (hasIO){\n    each(document.querySelectorAll(\".hero, .cta\"), function(sec){\n      new IntersectionObserver(function(es){ sec.classList.toggle(\"is-paused\", !es[0].isIntersecting); }).observe(sec);\n    });\n  }\n\n  /* ---------- mobile CTA bar: only when no other strategy-call CTA (hero, trust strip, contact form) is on screen ---------- */\n  var mcta = document.getElementById(\"mcta\");\n  var ctaWatch = [document.querySelector(\".hero__ctas\"), document.querySelector(\".trust__cta\"), document.getElementById(\"start\")].filter(Boolean);\n  if (mcta && hasIO && ctaWatch.length){\n    var ctaSeen = new Map();\n    mcta.classList.add(\"is-hidden\");\n    var ctaIO = new IntersectionObserver(function(es){\n      es.forEach(function(e){ ctaSeen.set(e.target, e.isIntersecting); });\n      var anyVisible = false; ctaSeen.forEach(function(v){ if (v) anyVisible = true; });\n      mcta.classList.toggle(\"is-hidden\", anyVisible);\n    });\n    ctaWatch.forEach(function(el){ ctaIO.observe(el); });\n  }\n\n  /* ---------- hero lead path (EXAMPLE content, not client data) ---------- */\n  /* pause/play icons shared by the demo and the logo loop */\n  var icPause = '<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><rect x=\"6\" y=\"5\" width=\"4\" height=\"14\" rx=\"1\"/><rect x=\"14\" y=\"5\" width=\"4\" height=\"14\" rx=\"1\"/></svg>';\n  var icPlay = '<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M7 5.5v13a1 1 0 001.5.86l11-6.5a1 1 0 000-1.72l-11-6.5A1 1 0 007 5.5z\"/></svg>';\n  var flow = document.getElementById(\"flow\");\n  if (flow && !reduce){\n    var leads = [\n      {trade:\"HVAC\",       ad:\"AC blowing warm air? Same-day repair\", job:\"AC repair\", slot:\"Tue · 9:00 AM\"},\n      {trade:\"Roofing\",    ad:\"Hail hit your roof? Free inspection\",  job:\"Roof inspection\",     slot:\"Wed · 1:30 PM\"},\n      {trade:\"Plumbing\",   ad:\"Water heater out? Fixed today\",        job:\"Water heater install\",      slot:\"Thu · 10:00 AM\"},\n      {trade:\"Electrical\", ad:\"Panel upgrade quotes this week\",       job:\"Panel upgrade\",      slot:\"Fri · 8:30 AM\"}\n    ];\n    var steps = flow.querySelectorAll(\".flow__step\");\n    var rail = flow.querySelector(\".flow__rail\");\n    var fill = flow.querySelector(\".flow__fill\");\n    var pulse = flow.querySelector(\".flow__pulse\");\n    var ring = flow.querySelector(\"[data-ring]\");\n    var idx = 0, timers = [], running = false, onScreen = true, railTop = 0, railH = 1;\n\n    var centerOf = function(step){ var ic = step.querySelector(\".flow__ic\"); return ic.offsetTop + ic.offsetHeight / 2; };\n    var layoutRail = function(){\n      railTop = centerOf(steps[0]);\n      railH = Math.max(centerOf(steps[steps.length - 1]) - railTop, 1);\n      rail.style.top = railTop + \"px\";\n      rail.style.height = railH + \"px\";\n    };\n    var later = function(fn, ms){ timers.push(setTimeout(fn, ms)); };\n    var stop = function(){ timers.forEach(clearTimeout); timers = []; running = false; };\n    var light = function(n){\n      steps[n].classList.add(\"is-on\");\n      if (n === 1 && ring && ring.animate){\n        ring.animate([{transform:\"rotate(0deg)\"},{transform:\"rotate(-14deg)\"},{transform:\"rotate(11deg)\"},{transform:\"rotate(-7deg)\"},{transform:\"rotate(0deg)\"}],\n                     {duration:640, easing:\"cubic-bezier(.33,1,.68,1)\"});\n      }\n    };\n    var travel = function(a, b){\n      var y0 = centerOf(steps[a]) - railTop, y1 = centerOf(steps[b]) - railTop;\n      fill.style.transform = \"scaleY(\" + (y1 / railH) + \")\";\n      if (pulse.animate){\n        pulse.animate([{transform:\"translateY(\" + y0 + \"px)\", opacity:0}, {opacity:1, offset:.2}, {opacity:1, offset:.8}, {transform:\"translateY(\" + y1 + \"px)\", opacity:0}],\n                      {duration:600, easing:\"cubic-bezier(.16,1,.3,1)\"});\n      }\n    };\n    var setLead = function(d){ each(flow.querySelectorAll(\"[data-f]\"), function(el){ el.textContent = d[el.getAttribute(\"data-f\")]; }); };\n    var run = function(){\n      stop(); running = true; layoutRail();\n      each(steps, function(st){ st.classList.remove(\"is-on\"); });\n      fill.style.transform = \"scaleY(0)\";\n      later(function(){ light(0); }, 300);\n      later(function(){ travel(0, 1); }, 1500);\n      later(function(){ light(1); }, 2050);\n      later(function(){ travel(1, 2); }, 3350);\n      later(function(){ light(2); }, 3900);\n      later(function(){\n        flow.classList.add(\"is-swapping\");\n        later(function(){\n          idx = (idx + 1) % leads.length;\n          setLead(leads[idx]);\n          flow.classList.remove(\"is-swapping\");\n          run();\n        }, 220);\n      }, 6800);\n    };\n    var paused = false;\n    var maybeRun = function(){ if (onScreen && !document.hidden && !running && !paused) run(); };\n\n    /* pause control: stops the loop and the ambient glows, shows the static finished path */\n    var foot = flow.querySelector(\".flow__foot\");\n    var pauseBtn = document.createElement(\"button\");\n    var setPauseBtn = function(){\n      pauseBtn.innerHTML = (paused ? icPlay : icPause) + (paused ? \"Play\" : \"Pause\");\n      pauseBtn.setAttribute(\"aria-label\", paused ? \"Play the example animation\" : \"Pause the example animation\");\n    };\n    pauseBtn.type = \"button\"; pauseBtn.className = \"pause-btn\"; setPauseBtn();\n    if (foot) foot.appendChild(pauseBtn);\n    pauseBtn.addEventListener(\"click\", function(){\n      paused = !paused;\n      document.documentElement.classList.toggle(\"motion-off\", paused);\n      if (paused){ stop(); flow.classList.remove(\"is-live\"); }\n      else { flow.classList.add(\"is-live\"); layoutRail(); maybeRun(); }\n      setPauseBtn();\n    });\n\n    flow.classList.add(\"is-live\");\n    layoutRail();\n    window.addEventListener(\"resize\", layoutRail);\n    document.addEventListener(\"visibilitychange\", function(){ if (document.hidden) stop(); else maybeRun(); });\n    if (hasIO){\n      new IntersectionObserver(function(es){ onScreen = es[0].isIntersecting; if (onScreen) maybeRun(); else stop(); }).observe(flow);\n    } else {\n      run();\n    }\n  }\n\n  /* ---------- client logos: a still row until there are enough to loop (data-min) ---------- */\n  var marquee = document.querySelector(\"[data-marquee]\");\n  var mTrack = marquee && marquee.querySelector(\".marquee__track\");\n  if (mTrack && !reduce && mTrack.children.length >= (parseInt(marquee.getAttribute(\"data-min\"), 10) || 5)){\n    var fillMarquee = function(){\n      each(marquee.querySelectorAll(\".marquee__track[aria-hidden]\"), function(c){ c.parentNode.removeChild(c); });\n      var w = mTrack.offsetWidth || 1;\n      marquee.style.setProperty(\"--marquee-dur\", Math.round(w / 45) + \"s\");\n      for (var n = Math.ceil(marquee.clientWidth / w); n > 0; n--){\n        var copy = mTrack.cloneNode(true);\n        copy.setAttribute(\"aria-hidden\", \"true\");\n        each(copy.querySelectorAll(\"img\"), function(img){ img.alt = \"\"; });\n        marquee.appendChild(copy);\n      }\n    };\n    marquee.classList.add(\"is-looping\");\n    fillMarquee();\n    var mTimer; window.addEventListener(\"resize\", function(){ clearTimeout(mTimer); mTimer = setTimeout(fillMarquee, 200); });\n    var mPaused = false, mBtn = document.createElement(\"button\");\n    var drawM = function(){\n      mBtn.innerHTML = (mPaused ? icPlay : icPause) + (mPaused ? \"Play\" : \"Pause\");\n      mBtn.setAttribute(\"aria-label\", mPaused ? \"Play the logo scroll\" : \"Pause the logo scroll\");\n    };\n    mBtn.type = \"button\"; mBtn.className = \"pause-btn\"; drawM();\n    mBtn.addEventListener(\"click\", function(){ mPaused = !mPaused; marquee.classList.toggle(\"is-paused\", mPaused); drawM(); });\n    var mFoot = document.querySelector(\".clients__foot\");\n    if (mFoot) mFoot.appendChild(mBtn);\n  }\n\n  /* ---------- AI Website Chatbot preview (front-end only; not wired to a live backend) ---------- */\n  var chatBtn = document.getElementById(\"chatw-btn\"), chatPanel = document.getElementById(\"chatw-panel\");\n  if (chatBtn && chatPanel){\n    var chatClose = document.getElementById(\"chatw-close\");\n    var setChat = function(open, returnFocus){\n      chatPanel.hidden = !open;\n      chatBtn.setAttribute(\"aria-expanded\", String(open));\n      chatBtn.setAttribute(\"aria-label\", open ? \"Close chat preview\" : \"Open chat preview\");\n      if (open) chatClose.focus(); else if (returnFocus) chatBtn.focus();\n    };\n    chatBtn.addEventListener(\"click\", function(){ setChat(chatPanel.hidden, true); });\n    chatClose.addEventListener(\"click\", function(){ setChat(false, true); });\n    chatPanel.addEventListener(\"keydown\", function(e){ if (e.key === \"Escape\") setChat(false, true); });\n    chatPanel.querySelector(\".chatw__foot a\").addEventListener(\"click\", function(){ setChat(false, false); });\n  }\n\n  /* ---------- FAQ accordion ---------- */\n  each(document.querySelectorAll(\".faq__q\"), function(btn){\n    btn.addEventListener(\"click\", function(){\n      var open = btn.getAttribute(\"aria-expanded\") !== \"true\";\n      btn.setAttribute(\"aria-expanded\", String(open));\n      var item = btn.closest(\".faq__item\");\n      if (item) item.classList.toggle(\"is-open\", open);\n    });\n  });\n\n  /* ---------- strategy-call form (Netlify Forms) ---------- */\n  var form = document.getElementById(\"demoForm\");\n  var status = document.getElementById(\"formStatus\");\n  var btnLabel = document.getElementById(\"formBtnLabel\");\n  var labels = {ads:\"Book Your Free Strategy Call\", website:\"See my demo site\", receptionist:\"Ask about the receptionist\", strategy:\"Get my growth plan\", mix:\"Get my plan\"};\n  each(form.querySelectorAll('input[name=\"interest\"]'), function(r){\n    r.addEventListener(\"change\", function(){ if (r.checked && btnLabel) btnLabel.textContent = labels[r.value]; });\n  });\n  each(form.querySelectorAll(\"input[required]\"), function(i){\n    i.addEventListener(\"input\", function(){ if (i.value.trim()){ i.removeAttribute(\"aria-invalid\"); i.removeAttribute(\"aria-describedby\"); } });\n  });\n  form.addEventListener(\"submit\", function(e){\n    e.preventDefault();\n    var missing = Array.prototype.filter.call(form.querySelectorAll(\"input[required]\"), function(i){ return !i.value.trim(); });\n    each(form.querySelectorAll(\"input[required]\"), function(i){ i.removeAttribute(\"aria-invalid\"); i.removeAttribute(\"aria-describedby\"); });\n    if (missing.length){\n      var lbl = (missing[0].previousElementSibling.textContent || \"details\").toLowerCase().replace(/^your\\s+/, \"\");\n      status.textContent = \"Add your \" + lbl + \" and we'll get started.\";\n      missing.forEach(function(i){ i.setAttribute(\"aria-invalid\", \"true\"); i.setAttribute(\"aria-describedby\", \"formStatus\"); });\n      missing[0].focus();\n      return;\n    }\n    var submitBtn = form.querySelector('button[type=\"submit\"]');\n    submitBtn.disabled = true;\n    status.textContent = \"Sending…\";\n    fetch(form.getAttribute(\"action\") || \"/\", {\n      method: \"POST\",\n      headers: {\"Content-Type\": \"application/x-www-form-urlencoded\"},\n      body: new URLSearchParams(new FormData(form)).toString()\n    }).then(function(r){\n      if (!r.ok) throw new Error(\"HTTP \" + r.status);\n      form.reset();\n      if (btnLabel) btnLabel.textContent = labels.ads;\n      status.textContent = \"Thanks! We got it and we'll call you soon.\";\n    }).catch(function(){\n      status.textContent = \"That didn't go through. Please try again in a minute.\";\n    }).then(function(){ submitBtn.disabled = false; });\n  });\n})();\n</script>\n</body>\n</html>\n","exit_code":0,"status":"completed"}}
