es via JS. -->\n    <figure class=\"flow up\" id=\"flow\" style=\"--d:720ms\" aria-labelledby=\"flow-cap\">\n      <figcaption class=\"flow__head\">\n        <span id=\"flow-cap\">How a lead reaches you</span>\n        <span class=\"flow__tag\"><span data-f=\"trade\">HVAC</span> · example</span>\n      </figcaption>\n      <div class=\"flow__body\">\n        <span class=\"flow__rail\" aria-hidden=\"true\"><span class=\"flow__fill\"></span><span class=\"flow__pulse\"></span></span>\n        <ol class=\"flow__steps\">\n          <li class=\"flow__step\">\n            <span class=\"flow__ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 15v-4a2 2 0 012-2h2l7-4v16l-7-4H5a2 2 0 01-2-2z\"/><path d=\"M18 9.5a4 4 0 010 5\"/></svg></span>\n            <div>\n              <p class=\"flow__k\">Your ad shows up <span class=\"flow__src\">Facebook · Google</span></p>\n              <p class=\"flow__v\">&ldquo;<span data-f=\"ad\">AC blowing warm air? Same-day repair</span>&rdquo;</p>\n              <p class=\"flow__meta\">Shown to homeowners in your service area</p>\n            </div>\n          </li>\n          <li class=\"flow__step\">\n            <span class=\"flow__ic\"><svg data-ring viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.4 1.8.7 2.7a2 2 0 01-.5 2.1L8 9.8a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.8.6 2.7.7a2 2 0 011.7 2z\"/></svg></span>\n            <div>\n              <p class=\"flow__k\">The phone rings <span class=\"flow__src\">Straight to you</span></p>\n              <p class=\"flow__v\">New caller asking about <span data-f=\"job\">AC repair</span></p>\n            </div>\n          </li>\n      