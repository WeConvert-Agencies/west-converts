{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1244,1318p' weconvert-site/index.html\nsed -n '1465,1560p' weconvert-site/index.html\"","aggregated_output":"          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============================ FOUNDER ============================ -->\n<!-- PLACEHOLDER: swap the DT monogram for a real photo of Danny (natural light beats studio). -->\n<section class=\"section section--tint founder-sec\" id=\"about\" aria-labelledby=\"about-title\">\n  <div class=\"container\">\n    <div class=\"founder\">\n      <div>\n        <h2 id=\"about-title\">Founder-led, from the first call on.</h2>\n        <blockquote class=\"founder__quote\">&ldquo;We&rsquo;d rather give you a straight answer than walk you through a proposal. That&rsquo;s the whole pitch.&rdquo;</blockquote>\n      </div>\n      <div class=\"founder__card\">\n        <div class=\"founder__photo\" aria-hidden=\"true\">DT</div>\n        <div>\n          <p class=\"founder__sig\">Danny Tellez</p>\n          <p class=\"founder__role\">Founder, West Converts</p>\n        </div>\n        <p class=\"founder__bio\">I&rsquo;m a young entrepreneur based in Fort Collins, Colorado. I started West Converts so trades businesses could get marketing with straight answers and a direct line to the people doing the work. Our team runs the campaigns and builds the sites, and I personally oversee every project.</p>\n        <p class=\"founder__area\">Working with trades businesses across Northern Colorado, including Fort Collins, Loveland, Greeley, Windsor and Longmont, and expanding beyond Colorado.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============================ CLIENTS ============================ -->\n<section class=\"clients\" id=\"clients\" aria-labelledby=\"clients-title\">\n  <div class=\"container\">\n    <h2 id=\"clients-title\">You&rsquo;re in good company.</h2>\n\n    <!-- Client logos. Add each new client as another <li> (white or light logo on a transparent PNG, base64-inlined).\n         The row stays still until there are data-min logos, then it scrolls on a loop with a Pause button.\n         Wide wordmarks sit at the base height; for a squarer logo add style=\"--s:1.2\" so it carries the same weight. -->\n    <div class=\"marquee\" data-marquee data-min=\"5\">\n      <ul class=\"marquee__track\">\n        <li><img src=\"data:image/png;base64,\" width=\"93\" height=\"48\" style=\"--s:1.2\" alt=\"NuWave Heating &amp; Cooling Pros\"></li>\n        <li><img src=\"data:image/png;base64,\" width=\"110\" height=\"36\" alt=\"Hot &amp; Cold Mechanical\"></li>\n      </ul>\n    </div>\n\n    <!-- TESTIMONIAL SLOT: when a client gives you a quote in their own words, it can go here, under the logos.\n         Never write one for them. -->\n    <div class=\"clients__foot\">\n      <a class=\"invite\" href=\"#start\">Want your business and testimonial featured here? Let us know <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n    </div>\n\n    <div class=\"svc-cta cta-band\">\n      <p>Want your business up here next?<span>Book a free strategy call and get a straight answer on what we&rsquo;d do for you.</span></p>\n      <a class=\"btn btn--primary btn--lg\" href=\"#start\">Book Your Free Strategy Call <svg class=\"btn__arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n    </div>\n  </div>\n</section>\n\n<!-- ============================ FAQ ============================ -->\n<section class=\"section section--tint\" id=\"faq\">\n  <div class=\"container\">\n    <div class=\"sec-head sec-head--center\">\n      <h2>The questions owners actually ask.</h2>\n    </div>\n    <div class=\"faq\">\n      <div class=\"faq__item\">\n        <h3>\n          <button class=\"faq__q\" type=\"button\" id=\"faq-q1\" aria-expanded=\"false\" aria-controls=\"faq-a1\">\n            <span>What does it cost?</span>\n            <span class=\"faq__ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></span>\n          </button>\n        </h3>\n        <div class=\"faq__a\" id=\"faq-a1\" role=\"region\" aria-labelledby=\"faq-q1\">\n          <div>\n            <p>Every business is different, so everything we do is custom quoted. On a free strategy call we look at your market, your goals and what you already have, then give you a straight number.</p>\n            <p>The call is free, and there&#x27;s no obligation after it.</p>\n            <span>Who will I actually be working with?</span>\n            <span class=\"faq__ic\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></span>\n          </button>\n        </h3>\n        <div class=\"faq__a\" id=\"faq-a12\" role=\"region\" aria-labelledby=\"faq-q12\">\n          <div>\n            <p>Our team runs your campaigns and builds your site, and Danny, our founder, personally oversees every project.</p>\n            <p>You get a direct line to the people doing the work, and they&#x27;re the same people before and after you pay.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============================ FINAL CTA ============================ -->\n<section class=\"section cta\" id=\"start\">\n  <span class=\"cta__glow\" aria-hidden=\"true\"></span>\n  <div class=\"container cta__inner\">\n    <div>\n      <h2>Tell us about your business. We&rsquo;ll show you the plan.</h2>\n      <p class=\"cta__lede\">Send your name, number and business. We&rsquo;ll call back with a plan for your ads: which jobs, which towns, and exactly what a month would cost. Need a website too? We&rsquo;ll build you a free demo first.</p>\n      <ul class=\"cta__list\">\n        <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>A clear plan before you spend anything</li>\n        <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>Nobody chases you if you decide to pass</li>\n        <li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>Straight answers, no pitch deck</li>\n      </ul>\n    </div>\n\n    <!-- Netlify Forms: submissions appear in Netlify under Forms > strategy-call (form detection must be on).\n         Without JS the form posts natively; with JS it posts in place and shows a status message. -->\n    <form class=\"form\" id=\"demoForm\" name=\"strategy-call\" method=\"POST\" action=\"/\" data-netlify=\"true\" netlify-honeypot=\"company-website\" novalidate>\n      <input type=\"hidden\" name=\"form-name\" value=\"strategy-call\">\n      <p class=\"hp\" aria-hidden=\"true\"><label>Leave this empty <input name=\"company-website\" tabindex=\"-1\" autocomplete=\"off\"></label></p>\n      <h3>Book your free strategy call</h3>\n      <p class=\"form__sub\">Takes 30 seconds. You'll get a straight answer on what it would cost.</p>\n\n      <fieldset class=\"choice\">\n        <legend>What are you looking for?</legend>\n        <div class=\"choice__opts\">\n          <label class=\"chip\"><input type=\"radio\" name=\"interest\" value=\"ads\" checked>Ads</label>\n          <label class=\"chip\"><input type=\"radio\" name=\"interest\" value=\"website\">Website</label>\n          <label class=\"chip\"><input type=\"radio\" name=\"interest\" value=\"receptionist\">AI Receptionist</label>\n          <label class=\"chip\"><input type=\"radio\" name=\"interest\" value=\"strategy\">Growth strategy</label>\n          <label class=\"chip\"><input type=\"radio\" name=\"interest\" value=\"mix\">A mix</label>\n        </div>\n      </fieldset>\n\n      <div class=\"field\">\n        <label for=\"f-name\">Your name</label>\n        <input type=\"text\" id=\"f-name\" name=\"name\" autocomplete=\"name\" placeholder=\"First and last name\" required>\n      </div>\n      <div class=\"field\">\n        <label for=\"f-phone\">Phone</label>\n        <input type=\"tel\" id=\"f-phone\" name=\"phone\" autocomplete=\"tel\" inputmode=\"tel\" placeholder=\"(970) 000-0000\" required>\n      </div>\n      <div class=\"field\">\n        <label for=\"f-biz\">Business name</label>\n        <input type=\"text\" id=\"f-biz\" name=\"business\" autocomplete=\"organization\" placeholder=\"Your business name\" required>\n      </div>\n\n      <button class=\"btn btn--primary btn--lg\" type=\"submit\">\n        <span id=\"formBtnLabel\">Book Your Free Strategy Call</span>\n        <svg class=\"btn__arrow\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n      </button>\n      <p class=\"form__status\" id=\"formStatus\" role=\"status\" aria-live=\"polite\"></p>\n      <p class=\"form__fine\">Your number is never sold or shared.</p>\n    </form>\n  </div>\n</section>\n\n</main>\n\n<!-- ============================ FOOTER ============================ -->\n<footer class=\"footer\">\n  <div class=\"container\">\n    <div class=\"footer__top\">\n      <div>\n        <a class=\"brand\" href=\"#top\">\n          <span class=\"brand__mark\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 11l3.2 10L13.4 11M13.4 21l3.2-10 3.2 10M19.8 11L23 21\"/></svg>\n          </span>\n          West Converts\n        </a>\n        <p class=\"footer__about\">Meta &amp; Google ads, websites and AI receptionists for HVAC, roofing, plumbing and electrical businesses. Founder-led, based in Fort Collins, Colorado.</p>\n        <p class=\"footer__areas\"><strong>Service area:</strong> Fort Collins · Loveland · Greeley · Windsor · Timnath · Wellington · Berthoud · Johnstown · Longmont, and expanding beyond Colorado.</p>\n      </div>\n\n      <div>\n        <h4>Services</h4>\n        <nav class=\"footer__links\" aria-label=\"Services\">\n          <a href=\"#services\">Meta &amp; Google Ads</a>\n          <a href=\"#services\">Website Design &amp; Build</a>\n          <a href=\"#ai-receptionist\">AI Receptionist</a>\n          <a href=\"#ai-chatbot\">AI Website Chatbot</a>\n          <a href=\"#services\">Google Business Profile &amp; Local SEO</a>\n","exit_code":0,"status":"completed"}}
