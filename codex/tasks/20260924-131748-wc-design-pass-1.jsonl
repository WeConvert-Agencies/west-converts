{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '261,570p' weconvert-site/index.html\"","aggregated_output":"/* live states: the static default above shows every step complete */\n.flow.is-live .flow__rail{display:block}\n.flow.is-live .flow__ic{background:var(--card-d2);color:var(--on-d2);border-color:var(--line-d)}\n.flow.is-live .flow__v{color:var(--on-d2)}\n.flow.is-live .flow__step:not(.is-on) .flow__check{stroke-dashoffset:10}\n.flow.is-live .flow__step.is-on .flow__ic{background:rgba(185,28,28,.16);color:var(--ember);border-color:rgba(185,28,28,.55);box-shadow:0 8px 18px -8px rgba(185,28,28,.75)}\n.flow.is-live .flow__step.is-on .flow__v{color:var(--on-d)}\n[data-f]{transition:opacity .32s var(--ease),filter .32s var(--ease)}\n.flow.is-swapping [data-f]{opacity:0;filter:blur(3px);transition-duration:.18s}\n\n\n/* ---- trust strip: two promise pills with the CTA pill between them ---- */\n.trust{background:var(--char-2);border-top:1px solid var(--line-d);color:var(--on-d)}\n.trust__row{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:var(--sp-3) var(--sp-4);padding-block:var(--sp-6)}\n.trust__item{\n  display:inline-flex;align-items:center;gap:.65rem;min-height:48px;padding:.45rem 1.3rem .45rem .5rem;\n  border-radius:var(--r-pill);background:linear-gradient(180deg,#1E1E1E 0%,#151515 100%);border:1px solid var(--line-d);\n  box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 12px 26px -16px rgba(0,0,0,.95);\n  font-size:var(--fs-sm);font-weight:600;color:var(--on-d);\n  transition:transform .25s var(--ease),border-color .25s var(--ease);\n}\n.trust__item:hover{transform:translateY(-2px);border-color:#3F3F3F}\n.trust__ic{width:34px;height:34px;flex:none;border-radius:50%;display:grid;place-items:center;background:rgba(185,28,28,.18);border:1px solid rgba(216,90,90,.5);color:var(--ember)}\n.trust__ic svg{width:16px;height:16px}\n.trust__btn{\n  min-height:54px;padding:0 1.6rem;border-radius:var(--r-pill);background:var(--red);color:var(--on-d);\n  font-size:var(--fs-body);font-weight:700;\n  box-shadow:0 0 0 5px rgba(185,28,28,.2),0 14px 30px -10px rgba(185,28,28,.85);\n}\n.trust__btn:hover{background:var(--red-2);box-shadow:0 0 0 7px rgba(185,28,28,.24),0 16px 34px -10px rgba(185,28,28,.9)}\n/* pops in once, right after the hero lines */\n.js .trust__row > li{opacity:0;transform:translateY(10px) scale(.94);animation:pop .6s cubic-bezier(.34,1.56,.64,1) forwards}\n.js .trust__row > li:nth-child(1){animation-delay:.9s}\n.js .trust__row > li:nth-child(2){animation-delay:1.02s}\n.js .trust__row > li:nth-child(3){animation-delay:1.14s}\n@keyframes pop{to{opacity:1;transform:none}}\n@media (max-width:620px){\n  .trust__row{flex-direction:column;align-items:stretch}\n  .trust__btn{width:100%}\n}\n\n/* ===================== services (stage 3): flagship ads panel, core services, also-available ===================== */\n.svc-sec{background:var(--paper-2)}\n.sic{width:48px;height:48px;flex:none;border-radius:12px;display:grid;place-items:center}\n.sic svg{width:22px;height:22px}\n.sic--sm{width:42px;height:42px;border-radius:11px}\n.sic--sm svg{width:20px;height:20px}\n.sic--d{background:rgba(185,28,28,.16);border:1px solid rgba(216,90,90,.5);color:var(--ember)}\n.sic--l{background:var(--accent-tint);border:1px solid var(--accent-line);color:var(--red)}\n.tag{display:inline-flex;align-items:center;min-height:26px;padding:0 .7rem;border-radius:var(--r-pill);font-size:var(--fs-xs);font-weight:700;letter-spacing:.01em;white-space:nowrap}\n.tag--red{background:var(--red);color:var(--on-d)}\n.tag--soft{background:var(--accent-tint);color:var(--red-2);border:1px solid var(--accent-line)}\n.cq{font-size:var(--fs-sm);font-weight:600;color:var(--ink-muted)}\n.slink{display:inline-flex;align-items:center;gap:.4rem;min-height:44px;font-size:var(--fs-sm);font-weight:700;color:var(--red);text-decoration:none}\n.slink svg{width:14px;height:14px;flex:none;transition:transform .25s var(--ease)}\n.slink:hover{text-decoration:underline;text-underline-offset:.22em}\n.slink:hover svg{transform:translateX(3px)}\n.chips{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:var(--sp-4)}\n.chips li{font-size:var(--fs-xs);font-weight:500;color:var(--ink-soft);background:var(--paper-2);border:1px solid var(--line);border-radius:var(--r-pill);padding:.28rem .7rem}\n\n/* flagship: dark, full width, sub-services inside */\n.flag{\n  position:relative;isolation:isolate;overflow:hidden;\n  display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(1.75rem,3.5vw,3rem);\n  padding:clamp(1.75rem,4vw,3rem);border-radius:22px;background:var(--char);color:var(--on-d);\n  border:1px solid #1F1F1F;box-shadow:0 30px 60px -30px rgba(10,10,10,.55);\n}\n.flag::before{content:\"\";position:absolute;z-index:-1;left:-18%;top:-45%;width:72%;aspect-ratio:1;border-radius:50%;background:radial-gradient(closest-side,rgba(185,28,28,.26),rgba(185,28,28,0));filter:blur(18px);pointer-events:none}\n.flag__top{display:flex;align-items:center;gap:var(--sp-3);flex-wrap:wrap}\n.flag h3{margin-top:var(--sp-5);font-size:clamp(1.875rem,1.35rem + 2vw,2.75rem);font-weight:800;letter-spacing:-.024em;color:var(--on-d)}\n.flag__lede{margin-top:var(--sp-4);max-width:36rem;font-size:var(--fs-lg);line-height:1.6;color:var(--on-d2)}\n.flag__list{margin-top:var(--sp-6);display:grid;gap:.75rem}\n.flag__list li{display:grid;grid-template-columns:auto 1fr;gap:.65rem;align-items:start;font-size:var(--fs-sm);color:var(--on-d)}\n.flag__list svg{width:16px;height:16px;margin-top:.25rem;color:var(--ember)}\n.flag__cta{margin-top:var(--sp-7);display:flex;flex-wrap:wrap;align-items:center;gap:var(--sp-3) var(--sp-5)}\n.flag__cta p{font-size:var(--fs-sm);color:var(--on-d2)}\n.flag__subs{display:grid;gap:var(--sp-3);align-content:start}\n.sub{\n  display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--sp-4);align-items:start;\n  padding:var(--sp-5);border-radius:16px;background:var(--card-d);border:1px solid var(--line-d);\n  transition:border-color .25s var(--ease),transform .25s var(--ease);\n}\n.sub:hover{border-color:#474747;transform:translateY(-2px)}\n.sub h4{font-size:1.125rem;font-weight:700;letter-spacing:-.01em;color:var(--on-d)}\n.sub p{margin-top:.35rem;font-size:var(--fs-sm);color:var(--on-d2)}\n\n/* core services: two large white cards */\n.core{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-5);margin-top:var(--sp-5)}\n.scard,.mcard{\n  position:relative;display:flex;flex-direction:column;border-radius:20px;background:var(--paper);border:1px solid var(--line);\n  box-shadow:var(--shadow-sm);transition:transform .25s var(--ease),box-shadow .25s var(--ease),border-color .25s var(--ease);\n}\n.scard{padding:clamp(1.5rem,3vw,2.25rem)}\n.scard:hover,.mcard:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:var(--line-strong)}\n.scard__top{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3)}\n.scard h3{margin-top:var(--sp-5);font-size:clamp(1.5rem,1.25rem + 1vw,1.875rem);font-weight:800;letter-spacing:-.02em}\n.scard > p{margin-top:var(--sp-3);font-size:var(--fs-body);color:var(--ink-muted);max-width:54ch}\n.card-foot{margin-top:auto;padding-top:var(--sp-5);display:flex;align-items:center;justify-content:space-between;gap:var(--sp-2) var(--sp-4);flex-wrap:wrap}\n.svc-addon{\n  margin-top:var(--sp-5);display:grid;grid-template-columns:auto minmax(0,1fr);gap:var(--sp-4);align-items:start;\n  padding:var(--sp-5);border-radius:16px;background:var(--char);color:var(--on-d);border:1px solid #1F1F1F;\n}\n.svc-addon h4{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;font-size:1.125rem;font-weight:700;color:var(--on-d)}\n.svc-addon p{margin-top:.35rem;font-size:var(--fs-sm);color:var(--on-d2)}\n\n/* receptionist: an example of the text the owner receives (labeled as an example) */\n.svc-example{margin:var(--sp-5) 0 0;padding:var(--sp-5);border-radius:16px;background:var(--char);border:1px solid #1F1F1F}\n.svc-example figcaption{font-size:var(--fs-xs);font-weight:600;color:var(--on-d2)}\n.sms{margin-top:var(--sp-3);max-width:30rem;padding:.85rem 1rem;border-radius:16px 16px 16px 4px;background:var(--card-d2);border:1px solid var(--line-d)}\n.sms__from{font-size:var(--fs-xs);color:var(--on-d2)}\n.sms__txt{margin-top:.25rem;font-size:var(--fs-sm);line-height:1.5;color:var(--on-d)}\n\n/* also available: three compact cards */\n.more{margin-top:clamp(2.5rem,5vw,3.5rem)}\n.more > h3{font-size:var(--fs-h3);font-weight:800}\n.more__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--sp-4);margin-top:var(--sp-5)}\n.mcard{padding:var(--sp-6)}\n.mcard h4{margin-top:var(--sp-4);font-size:1.1875rem;font-weight:700;letter-spacing:-.01em}\n.mcard p{margin-top:var(--sp-2);font-size:var(--fs-sm);color:var(--ink-muted)}\n\n/* recurring CTA after services */\n.svc-cta{\n  margin-top:clamp(2.5rem,5vw,3.5rem);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--sp-4) var(--sp-6);\n  padding:clamp(1.5rem,3vw,2rem) clamp(1.5rem,3.5vw,2.5rem);border-radius:20px;background:var(--char);color:var(--on-d);\n}\n.svc-cta p{max-width:40rem;font-size:var(--fs-lg);font-weight:700;color:var(--on-d)}\n.svc-cta p span{display:block;margin-top:.3rem;font-size:var(--fs-sm);font-weight:400;color:var(--on-d2)}\n.flag :focus-visible,.svc-addon :focus-visible,.svc-cta :focus-visible{outline-color:var(--on-d)}\n\n@media (max-width:1040px){ .flag{grid-template-columns:minmax(0,1fr)} }\n@media (max-width:900px){ .core{grid-template-columns:1fr} .more__grid{grid-template-columns:repeat(2,minmax(0,1fr))} }\n@media (max-width:620px){\n  .more__grid{grid-template-columns:1fr}\n  .flag__cta .btn,.svc-cta .btn{width:100%}\n  .sub,.svc-addon{padding:var(--sp-4)}\n}\n\n/* ===================== AI Website Chatbot preview: FRONT-END ONLY, not wired to a live backend ===================== */\n.chatw{position:fixed;right:clamp(1rem,2.5vw,1.5rem);bottom:clamp(1rem,2.5vw,1.5rem);z-index:95;transition:bottom .3s var(--ease)}\n.chatw__btn{\n  width:60px;height:60px;border-radius:50%;border:0;background:var(--red);color:#fff;display:grid;place-items:center;cursor:pointer;\n  box-shadow:0 0 0 1px rgba(255,255,255,.2),0 12px 28px -8px rgba(185,28,28,.75);\n  transition:transform .2s var(--ease),background .2s var(--ease);\n}\n.chatw__btn:hover{background:var(--red-2);transform:translateY(-2px)}\n/* the bubble floats over light and dark sections: white halo + ink ring reads on both */\n.chatw__btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px;box-shadow:0 0 0 3px #FAFAFA,0 12px 28px -8px rgba(185,28,28,.75)}\n.chatw__btn svg{width:26px;height:26px}\n.chatw__btn .ic-x{display:none}\n.chatw__btn[aria-expanded=\"true\"] .ic-chat{display:none}\n.chatw__btn[aria-expanded=\"true\"] .ic-x{display:block}\n.chatw__panel{\n  position:absolute;right:0;bottom:76px;width:min(340px,calc(100vw - 2rem));overflow:hidden;\n  background:var(--char);color:var(--on-d);border:1px solid var(--line-d);border-radius:18px;\n  box-shadow:0 30px 60px -20px rgba(0,0,0,.65);transform-origin:100% 100%;animation:chatIn .28s var(--ease);\n}\n.chatw__panel[hidden]{display:none}\n@keyframes chatIn{from{opacity:0;transform:translateY(8px) scale(.97)}to{opacity:1;transform:none}}\n.chatw__head{display:flex;align-items:center;gap:.7rem;padding:.8rem .7rem .8rem 1rem;border-bottom:1px solid var(--line-d)}\n.chatw__av{width:34px;height:34px;flex:none;border-radius:50%;background:var(--red);display:grid;place-items:center}\n.chatw__av svg{width:20px;height:20px}\n.chatw__title{font-size:var(--fs-sm);font-weight:700;color:var(--on-d)}\n.chatw__sub{font-size:var(--fs-xs);color:var(--on-d2)}\n.chatw__close{margin-left:auto;width:44px;height:44px;flex:none;border:0;border-radius:10px;background:none;color:var(--on-d2);display:grid;place-items:center;cursor:pointer}\n.chatw__close:hover{background:var(--card-d);color:var(--on-d)}\n.chatw__close svg{width:18px;height:18px}\n.chatw__body{display:grid;gap:.6rem;padding:1rem}\n.msg{max-width:86%;padding:.65rem .85rem;border-radius:14px 14px 14px 4px;background:var(--card-d2);color:var(--on-d);font-size:var(--fs-sm);line-height:1.45}\n.msg--me{justify-self:end;border-radius:14px 14px 4px 14px;background:var(--red);color:#fff}\n.chatw__foot{display:grid;gap:.6rem;padding:.9rem 1rem 1rem;border-top:1px solid var(--line-d)}\n.chatw__foot .btn{width:100%}\n.chatw__note{font-size:var(--fs-xs);color:var(--on-d2);text-align:center}\n.chatw__panel :focus-visible{outline-color:var(--on-d)}\n@media (max-width:560px){\n  .mcta:not(.is-hidden) ~ .chatw{bottom:92px}\n  .chatw__btn{width:52px;height:52px}\n  .chatw__btn svg{width:23px;height:23px}\n  .chatw__panel{bottom:66px}\n}\n\n/* ===================== process — the line draws, each step lights as it passes ===================== */\n.steps{position:relative}\n.steps__track{position:absolute;left:0;right:0;top:14px;height:1px;background:var(--line-strong)}\n.steps__fill{position:absolute;inset:0;background:linear-gradient(90deg,var(--accent),var(--accent-2));transform-origin:0 50%;transition:transform 1.4s var(--ease)}\n.io .steps:not(.in) .steps__fill{transform:scaleX(0)}\n.steps__list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--sp-6)}\n.step{position:relative;padding-top:calc(28px + var(--sp-5))}\n.step__node{\n  position:absolute;top:0;left:0;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;\n  font-family:var(--font-display);font-size:var(--fs-xs);font-weight:600;\n  background:var(--accent);border:1px solid var(--accent);color:var(--paper);\n  transition:background .35s var(--ease),border-color .35s var(--ease),color .35s var(--ease);transition-delay:var(--nd,0s);\n}\n.step:nth-child(2) .step__node{--nd:.35s}\n.step:nth-child(3) .step__node{--nd:.7s}\n.step:nth-child(4) .step__node{--nd:1.05s}\n.io .steps:not(.in) .step__node{background:var(--paper);border-color:var(--line-strong);color:var(--ink-muted)}\n.step h3{margin-bottom:var(--sp-3)}\n.step p{font-size:var(--fs-sm);color:var(--ink-muted)}\n.step .step__time{margin-top:var(--sp-4);font-size:var(--fs-xs);font-weight:500;color:var(--ink-soft)}\n\n/* ===================== why us (comparison) ===================== */\n.why{display:grid;gap:clamp(2.5rem,5vw,4.5rem);grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);align-items:start}\n.point{padding-block:var(--sp-5);border-top:1px solid var(--line)}\n.point:first-child{border-top:0;padding-top:0}\n.point h3{font-size:var(--fs-h3);margin-bottom:.45rem}\n.point p{font-size:var(--fs-sm);color:var(--ink-muted);max-width:54ch}\n\n.cmp{border:1px solid var(--line);border-radius:var(--r-lg);overflow-x:auto;background:var(--paper);box-shadow:var(--shadow-sm)}\n.cmp table{width:100%;border-collapse:collapse;font-size:var(--fs-sm)}\n.cmp caption{text-align:left;padding:var(--sp-5) var(--sp-5) var(--sp-4);font-family:var(--font-display);font-weight:600;color:var(--ink);font-size:var(--fs-body);border-bottom:1px solid var(--line)}\n.cmp th,.cmp td{padding:.85rem var(--sp-5);text-align:left;border-bottom:1px solid var(--line);vertical-align:middle}\n.cmp thead th{font-family:var(--font-display);font-size:var(--fs-xs);font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-muted);background:var(--paper-2)}\n.cmp thead th:last-child{color:var(--accent)}\n.cmp tbody th{font-weight:500;color:var(--ink-soft);width:38%}\n.cmp tbody tr:last-child th,.cmp tbody tr:last-child td{border-bottom:0}\n.cmp tbody tr{transition:background .2s var(--ease)}\n.cmp tbody tr:hover{background:var(--paper-2)}\n.cmp td{color:var(--ink-muted)}\n.cmp td.yes{color:var(--ink);font-weight:500}\n.cmp .ic{display:inline-flex;align-items:center;gap:.45rem}\n.cmp .ic svg{width:15px;height:15px;flex:none}\n.cmp .yes svg{color:var(--accent)}\n.cmp .no svg{color:var(--ui-l)}\n@media (max-width:420px){ .cmp caption{padding:var(--sp-4) .8rem var(--sp-3)} .cmp th,.cmp td{padding:.75rem .6rem} .cmp thead th{letter-spacing:.03em} .cmp tbody th{width:auto} .cmp .ic{gap:.3rem} }\n@media (max-width:360px){ .cmp table{font-size:.875rem} .cmp th,.cmp td{padding:.7rem .45rem} .cmp thead th{letter-spacing:0} }\n\n/* ===================== why us: dark treatment ===================== */\n.why-sec{background:var(--char);color:var(--on-d)}\n.why-sec .sec-head h2{color:var(--on-d)}\n.why-sec .sec-head p{color:var(--on-d2)}\n.why-sec .point{border-top-color:var(--line-d)}\n.why-sec .point h3{color:var(--on-d)}\n.why-sec .point p{color:var(--on-d2)}\n.why-sec .cmp{background:var(--card-d);border-color:var(--line-d);box-shadow:none}\n.why-sec .cmp caption{color:var(--on-d);border-bottom-color:var(--line-d)}\n.why-sec .cmp th,.why-sec .cmp td{border-bottom-color:var(--line-d)}\n.why-sec .cmp thead th{background:var(--char-2);color:var(--on-d2)}\n.why-sec .cmp thead th:last-child{color:var(--ember)}\n.why-sec .cmp tbody th,.why-sec .cmp td.yes{color:var(--on-d)}\n.why-sec .cmp td{color:var(--on-d2)}\n.why-sec .cmp tbody tr:hover{background:var(--card-d2)}\n.why-sec .cmp .yes svg{color:var(--ember)}\n.why-sec .cmp .no svg{color:#5A5A5A}\n.why-sec :focus-visible{outline-color:var(--on-d)}\n\n/* ---- testimonial invite pill ---- */\n.invite{\n  display:inline-flex;align-items:center;gap:.45rem;min-height:44px;padding:.35rem 1rem;border-radius:var(--r-pill);\n  border:1px dashed var(--ui-l);font-size:var(--fs-xs);font-weight:600;color:var(--ink-muted);text-decoration:none;\n  transition:border-color .2s var(--ease),color .2s var(--ease);\n}\n.invite svg{width:13px;height:13px;flex:none;transition:transform .25s var(--ease)}\n.invite:hover{border-color:var(--red);color:var(--red)}\n.invite:hover svg{transform:translateX(3px)}\n.cta-band{margin-top:clamp(2.5rem,5vw,3.5rem)}\n\n/* ===================== clients: logo band (dark) ===================== */\n.clients{background:var(--char);color:var(--on-d);padding-block:clamp(4rem,8vw,6rem)}\n.clients h2{text-align:center;color:var(--on-d)}\n.marquee{margin-top:clamp(2rem,4vw,3rem);display:flex;justify-content:center;overflow:hidden}\n.marquee__track{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:var(--sp-6) clamp(2.5rem,6vw,4.5rem);margin:0;padding:0;list-style:none}\n.marquee__track img{display:block;height:calc(clamp(32px,3.6vw,40px) * var(--s,1));width:auto;opacity:.78;transition:opacity .3s var(--ease)}\n.marquee__track img:hover{opacity:1}\n.marquee.is-looping{justify-content:flex-start;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)}\n.marquee.is-looping .marquee__track{flex:none;flex-wrap:nowrap;padding-right:clamp(2.5rem,6vw,4.5rem);animation:marquee var(--marquee-dur,40s) linear infinite}\n.marquee.is-looping:hover .marquee__track,.marquee.is-paused .marquee__track{animation-play-state:paused}\n@keyframes marquee{to{transform:translateX(-100%)}}\n.clients__foot{margin-top:clamp(1.75rem,3.5vw,2.5rem);display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:var(--sp-3)}\n.clients .invite{border-color:var(--ui-d);color:var(--on-d2)}\n.clients .invite:hover{border-color:var(--ember);color:var(--on-d)}\n.clients .svc-cta{background:var(--card-d);border:1px solid var(--line-d)}\n.clients :focus-visible{outline-color:var(--on-d)}\n\n/* ===================== founder ===================== */\n.founder{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:clamp(2rem,5vw,4.5rem);align-items:center}\n.founder__quote{margin:var(--sp-5) 0 0;font-family:var(--font-display);font-size:clamp(1.25rem,1.05rem + .9vw,1.75rem);font-weight:600;line-height:1.35;letter-spacing:-.015em;color:var(--ink-soft);text-wrap:pretty;max-width:34ch}\n.founder__card{display:grid;grid-template-columns:64px minmax(0,1fr);gap:var(--sp-2) var(--sp-4);align-items:center;padding:clamp(1.5rem,3vw,2rem);border-radius:20px;background:var(--paper);border:1px solid var(--line);box-shadow:var(--shadow-sm)}\n.founder__photo{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;background:var(--char);color:var(--on-d);font-family:var(--font-display);font-size:1.25rem;font-weight:800;letter-spacing:-.02em;box-shadow:inset 0 0 0 2px var(--red)}\n.founder__sig{font-size:var(--fs-body);font-weight:700;color:var(--ink)}\n.founder__role{font-size:var(--fs-sm);color:var(--ink-muted)}\n.founder__bio{grid-column:1 / -1;margin-top:var(--sp-3);font-size:var(--fs-sm);color:var(--ink-muted)}\n.founder__area{grid-column:1 / -1;margin-top:var(--sp-2);padding-top:var(--sp-3);border-top:1px solid var(--line);font-size:var(--fs-xs);color:var(--ink-muted)}\n\n/* ===================== faq ===================== */\n.faq{max-width:50rem;margin-inline:auto}\n.faq__item{border-bottom:1px solid var(--line)}\n.faq__item h3{margin:0;font-size:inherit;letter-spacing:inherit;line-height:inherit}\n.faq__item:first-child{border-top:1px solid var(--line)}\n.faq__q{\n  width:100%;display:flex;align-items:center;justify-content:space-between;gap:var(--sp-4);\n  background:none;border:0;cursor:pointer;text-align:left;padding:1.4rem .25rem;\n  font-family:var(--font-display);font-size:var(--fs-h3);font-weight:600;color:var(--ink);\n  letter-spacing:-.015em;line-height:1.3;transition:color .2s var(--ease);\n}\n.faq__q:hover{color:var(--accent)}\n.faq__ic{\n  width:30px;height:30px;flex:none;border-radius:50%;border:1px solid var(--line-strong);\n  display:grid;place-items:center;transition:transform .35s var(--ease),border-color .25s var(--ease),background .25s var(--ease);\n}\n.faq__ic svg{width:14px;height:14px}\n.faq__q:hover .faq__ic{border-color:var(--accent);background:var(--accent-tint)}\n.faq__q[aria-expanded=\"true\"] .faq__ic{transform:rotate(45deg);border-color:var(--accent);background:var(--accent-tint);color:var(--accent)}\n.faq__a{display:grid;grid-template-rows:0fr;transition:grid-template-rows .4s var(--ease)}\n.faq__item.is-open .faq__a{grid-template-rows:1fr}\n.faq__item:has(.faq__q[aria-expanded=\"true\"]) .faq__a{grid-template-rows:1fr}\n.faq__a > div{overflow:hidden}\n.faq__a p{padding:0 3rem 1.5rem .25rem;color:var(--ink-muted);font-size:var(--fs-sm);max-width:44rem}\n.faq__a p + p{padding-top:.75rem;margin-top:-.5rem}\n\n","exit_code":0,"status":"completed"}}
