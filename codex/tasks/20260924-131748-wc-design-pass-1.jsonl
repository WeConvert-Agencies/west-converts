ixed;left:0;right:0;bottom:0;z-index:90;\n    padding:.625rem var(--gutter) calc(.625rem + env(safe-area-inset-bottom));\n    background:rgba(10,10,10,.95);border-top:1px solid var(--line-d);\n    transition:transform .3s var(--ease),opacity .3s var(--ease),visibility 0s;\n  }\n  .mcta .btn{width:100%}\n  .mcta.is-hidden{transform:translateY(110%);opacity:0;visibility:hidden;pointer-events:none;transition:transform .3s var(--ease),opacity .3s var(--ease),visibility 0s .3s}\n  body{padding-bottom:78px}\n}\n\n/* ===================== responsive ===================== */\n@media (max-width:1040px){\n  .hero__inner{grid-template-columns:1fr}\n  .hero h1{max-width:16ch}\n  .flow{max-width:36rem}\n  .hero__glow{width:92vw;left:-25%}\n  .why{grid-template-columns:1fr;gap:var(--sp-7)}\n  .steps__list{grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-7) var(--sp-6)}\n  .steps__track{display:none}\n  .founder{grid-template-columns:1fr;align-items:start}\n  .footer__top{grid-template-columns:1fr 1fr;gap:var(--sp-7)}\n}\n@media (max-width:900px){\n  .header__inner{gap:var(--sp-3)}\n  .nav{\n    position:fixed;inset:var(--header-h) 0 auto;flex-direction:column;align-items:stretch;\n    background:var(--char);border-bottom:1px solid var(--line-d);padding:var(--sp-3) var(--gutter) var(--sp-5);\n    margin:0;gap:.15rem;transform:translateY(-8px);opacity:0;visibility:hidden;\n    transition:opacity .25s var(--ease),transform .25s var(--ease),visibility .25s;\n    box-shadow:0 24px 40px -20px rgba(0,0,0,.8);\n  }\n  .header.open .nav{opacity:1;visibility:visible;transform:none}\n  .nav a{padding:.85rem .5rem;font-size:var(--fs-body);min-height:48px;display:flex;align-items:center}\n  .nav__ind{display:none}\n  .nav a[aria-current=\"true\"]{color:var(--on-d);box-shadow:inset 3px 0 0 var(--red)}\n  .header__cta{order:2;margin-left:auto}\n  .navtoggle{display:flex;order:3}\n  .cta__inner{grid-template-columns:1fr;gap:var(--sp-7)}\n  .cta h2{max-width:none}\n}\n@media (max-width: